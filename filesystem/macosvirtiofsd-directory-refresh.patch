+#[cfg(test)]
+mod perpendicular_directory_checks {
+    use super::*;
+    use std::collections::BTreeSet;
+
+    #[test]
+    fn rewinding_same_handle_observes_host_changes() {
+        let path = std::env::temp_dir().join(format!("perp-vfs-dir-{}-{}", std::process::id(),
+            std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()));
+        std::fs::create_dir(&path).unwrap();
+        std::fs::write(path.join("before.txt"), b"before").unwrap();
+        let fs = PassthroughFs::new(Config {root_dir: path.to_str().unwrap().into(), ..Default::default()}).unwrap();
+        fs.init(FsOptions::empty()).unwrap();
+        let context = Context {uid: unsafe {libc::getuid()}, gid: unsafe {libc::getgid()}, pid: 0};
+        let handle = fs.opendir(context, fuse::ROOT_ID, 0).unwrap().0.unwrap();
+        let mut first = BTreeSet::new();
+        fs.do_readdir(fuse::ROOT_ID, handle, 4096, 0, |entry| {
+            first.insert(String::from_utf8(entry.name.to_vec()).unwrap()); Ok(1)
+        }).unwrap();
+        assert!(first.contains("before.txt"));
+        std::fs::rename(path.join("before.txt"), path.join("renamed.txt")).unwrap();
+        std::fs::write(path.join("added-è日本語.txt"), b"added").unwrap();
+        let mut second = BTreeSet::new();
+        fs.do_readdir(fuse::ROOT_ID, handle, 4096, 0, |entry| {
+            second.insert(String::from_utf8(entry.name.to_vec()).unwrap()); Ok(1)
+        }).unwrap();
+        let mut plus = BTreeSet::new();
+        fs.readdirplus(context, fuse::ROOT_ID, handle, 4096, 0, |entry, attributes| {
+            plus.insert(String::from_utf8(entry.name.to_vec()).unwrap());
+            assert!(attributes.inode > 0);
+            Ok(1)
+        }).unwrap();
+        fs.do_release(fuse::ROOT_ID, handle).unwrap();
+        std::fs::remove_dir_all(&path).unwrap();
+        assert_eq!(plus, second, "READDIRPLUS must resolve the full non-NUL-terminated cached filename");
+        assert_eq!(second, BTreeSet::from(["renamed.txt".into(), "added-è日本語.txt".into()]),
+            "A new directory scan on the same handle must reflect host renames and creations");
+    }
+}
