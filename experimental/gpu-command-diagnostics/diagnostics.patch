+/* Opt-in bounded metadata diagnostics; command processing holds the BQL. */
+static bool virgl_cmd_diagnostic_admit(void)
+{
+    static int enabled = -1;
+    static unsigned int records;
+
+    if (enabled < 0) {
+        enabled = g_strcmp0(g_getenv("PERPENDICULAR_GPU_COMMAND_DIAGNOSTICS"),
+                            "1") == 0;
+    }
+    if (!enabled) {
+        return false;
+    }
+    if (records < 64) {
+        records++;
+        return true;
+    }
+    if (records == 64) {
+        records++;
+        fprintf(stderr, "perpendicular-gpu-cmd suppressed after 64 records\n");
+    }
+    return false;
+}
 
