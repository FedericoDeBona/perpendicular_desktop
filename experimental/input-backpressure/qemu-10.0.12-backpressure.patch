+static void vnc_input_update_watch(VncState *vs)
+{
+    vnc_lock_output(vs);
+    if (vs->ioc_tag) {
+        g_source_remove(vs->ioc_tag);
+    }
+    vs->ioc_tag = qio_channel_add_watch(vs->ioc,
+                                      vnc_client_io_flags(vs, vs->output.offset != 0),
+                                      vnc_client_io, vs, NULL);
+    vnc_unlock_output(vs);
+}
+
+static void vnc_input_retry(void *opaque)
+{
+    VncState *vs = opaque;
+
+    if (vs->disconnecting) {
+        return;
+    }
+    if (!vnc_input_try_switch(vs)) {
+        vnc_input_schedule_retry(vs);
+    }
+    if (!vs->input_blocked) {
+        return;
+    }
+    if (!qemu_input_keyboard_ready(vs->vd->dcl.con)) {
+        timer_mod(vs->input_retry_timer,
+                  qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 10);
+        return;
+    }
+    vs->input_blocked = false;
+    if (vnc_client_process_input(vs) < 0) {
+        return; /* The parser freed this VncState. */
+    }
+    if (!vs->input_blocked) {
+        vnc_input_update_watch(vs);
+    }
+}
+
+static bool vnc_input_admit(VncState *vs)
+{
+    /* One 4 KiB socket read plus the largest incomplete key message. Stop
+     * reading while blocked; do not accumulate an unbounded second queue. */
+    if (vs->input.offset > 4096 + 12) {
+        error_report("VNC keyboard backpressure buffer limit exceeded");
+        vnc_client_error(vs);
+        return false;
+    }
+    /* A busy surviving client cannot starve a disconnected client's owned
+     * releases by repeatedly taking the next available device slot. */
+    if (!bitmap_empty(vs->vd->input_releases, Q_KEY_CODE__MAX)) {
+        vnc_input_release_pending(vs->vd);
+    }
+    if (!qemu_console_is_graphic(vs->vd->dcl.con) ||
+        qemu_input_keyboard_ready(vs->vd->dcl.con)) {
+        return true;
+    }
+    vs->input_blocked = true;
+    vnc_input_schedule_retry(vs);
+    vnc_input_update_watch(vs);
+    return false;
+}
