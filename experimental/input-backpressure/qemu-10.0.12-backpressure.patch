+static void vnc_input_retry(void *opaque);
+
+static bool vnc_input_display_idle(VncDisplay *vd)
+{
+    VncState *client;
+
+    if (!bitmap_empty(vd->input_releases, Q_KEY_CODE__MAX) ||
+        !qemu_input_keyboard_ready(vd->dcl.con)) {
+        return false;
+    }
+    QTAILQ_FOREACH(client, &vd->clients, next) {
+        if (!client->disconnecting &&
+            (client->input_blocked ||
+             !bitmap_empty(client->input_keys, Q_KEY_CODE__MAX))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void vnc_input_schedule_retry(VncState *vs)
+{
+    if (!vs->input_retry_timer) {
+        vs->input_retry_timer = timer_new_ms(QEMU_CLOCK_REALTIME,
+                                            vnc_input_retry, vs);
+    }
+    timer_mod(vs->input_retry_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 10);
+}
+
+static void vnc_input_queue_switch(VncState *vs, unsigned int index)
+{
+    vs->input_switch_pending = true;
+    vs->input_switch_index = index;
+    vnc_input_schedule_retry(vs);
+}
+
+static bool vnc_input_try_switch(VncState *vs)
+{
+    QemuConsole *con;
+
+    if (!vs->input_switch_pending) {
+        return true;
+    }
+    if (!vnc_input_display_idle(vs->vd)) {
+        return false;
+    }
+    /* Look the index up again: never retain a possibly hot-unplugged console. */
+    con = qemu_console_lookup_by_index(vs->input_switch_index);
+    vs->input_switch_pending = false;
+    if (con && con != vs->vd->dcl.con) {
+        unregister_displaychangelistener(&vs->vd->dcl);
+        qkbd_state_switch_console(vs->vd->kbd, con);
+        vs->vd->dcl.con = con;
+        register_displaychangelistener(&vs->vd->dcl);
+    }
+    return true;
+}
+
+static bool vnc_input_key_owned(VncDisplay *vd, VncState *except, int qcode)
+{
+    VncState *client;
+
+    QTAILQ_FOREACH(client, &vd->clients, next) {
+        if (client != except && !client->disconnecting &&
+            test_bit(qcode, client->input_keys)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool vnc_input_track_key(VncState *vs, int qcode, bool down)
+{
+    if (down) {
+        set_bit(qcode, vs->input_keys);
+        clear_bit(qcode, vs->vd->input_releases);
+        return true;
+    }
+    if (!test_bit(qcode, vs->input_keys)) {
+        return false;
+    }
+    clear_bit(qcode, vs->input_keys);
+    return !vnc_input_key_owned(vs->vd, vs, qcode);
+}
+
+static void vnc_input_release_pending(void *opaque)
+{
+    VncDisplay *vd = opaque;
+    int qcode;
+
+    for (qcode = 0; qcode < Q_KEY_CODE__MAX; qcode++) {
+        if (!test_bit(qcode, vd->input_releases)) {
+            continue;
+        }
+        if (vnc_input_key_owned(vd, NULL, qcode)) {
+            clear_bit(qcode, vd->input_releases);
+            continue;
+        }
+        if (!qemu_input_keyboard_ready(vd->dcl.con)) {
+            timer_mod(vd->input_release_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 10);
+            return;
+        }
+        clear_bit(qcode, vd->input_releases);
+        qkbd_state_key_event(vd->kbd, qcode, false);
+    }
+    timer_free(vd->input_release_timer);
+    vd->input_release_timer = NULL;
+}
+
+static void vnc_input_disconnect(VncState *vs)
+{
+    VncDisplay *vd = vs->vd;
+    int qcode;
+
+    if (vs->input_retry_timer) {
+        timer_free(vs->input_retry_timer);
+        vs->input_retry_timer = NULL;
+    }
+    vs->input_blocked = false;
+    vs->input_switch_pending = false;
+    for (qcode = 0; qcode < Q_KEY_CODE__MAX; qcode++) {
+        if (test_bit(qcode, vs->input_keys) &&
+            !vnc_input_key_owned(vd, vs, qcode)) {
+            set_bit(qcode, vd->input_releases);
+        }
+    }
+    bitmap_zero(vs->input_keys, Q_KEY_CODE__MAX);
+    if (!bitmap_empty(vd->input_releases, Q_KEY_CODE__MAX)) {
+        if (!vd->input_release_timer) {
+            vd->input_release_timer = timer_new_ms(QEMU_CLOCK_REALTIME,
+                                                  vnc_input_release_pending, vd);
+        }
+        vnc_input_release_pending(vd);
+    }
+}
