+GIOCondition vnc_client_io_flags(VncState *vs, bool writing)
+{
+    return G_IO_HUP | G_IO_ERR | (vs->input_blocked ? 0 : G_IO_IN) |
+           (writing ? G_IO_OUT : 0);
+}
