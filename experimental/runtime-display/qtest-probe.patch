--- a/ui/vnc.c
+++ b/ui/vnc.c
@@ -4716,3 +4716,46 @@
     qemu_add_opts(&qemu_vnc_opts);
 }
 opts_init(vnc_register_config);
+
+/* Separate QA patch only. Not present in the production candidate. */
+uint64_t vnc_runtime_test_visible(void);
+uint64_t vnc_runtime_test_slots(void);
+void vnc_runtime_test_rebind(uint64_t head, Error **errp);
+void vnc_runtime_test_display(bool create, Error **errp);
+
+uint64_t vnc_runtime_test_visible(void)
+{
+    VncDisplay *vd = vnc_display_find(NULL);
+    return vd ? UINT64_C(1) << qemu_console_get_index(vd->dcl.con) : 0;
+}
+uint64_t vnc_runtime_test_slots(void)
+{
+    uint64_t used = 0;
+    unsigned int i;
+    for (i = 0; i < VNC_INPUT_CLEANUP_SLOTS; i++) {
+        used += vnc_input_cleanups[i].con != NULL;
+    }
+    return used;
+}
+void vnc_runtime_test_rebind(uint64_t head, Error **errp)
+{
+    VncDisplay *vd = vnc_display_find(NULL);
+    VncState *vs = vd ? QTAILQ_FIRST(&vd->clients) : NULL;
+    if (!vs || head > 1 || !vnc_input_display_idle(vd)) {
+        error_setg(errp, "Cannot rebind while keyboard input is pending");
+        return;
+    }
+    vnc_input_queue_switch(vs, head);
+    vnc_input_try_switch(vs);
+}
+void vnc_runtime_test_display(bool create, Error **errp)
+{
+    VncDisplay *vd = vnc_display_find(NULL);
+    if (create) {
+        if (!vd) {
+            vnc_display_new("default", errp);
+        }
+    } else if (vd) {
+        vnc_display_free(vd);
+    }
+}
