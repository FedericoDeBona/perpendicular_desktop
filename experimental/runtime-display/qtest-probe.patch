+uint64_t vnc_runtime_test_visible(void);
+uint64_t vnc_runtime_test_slots(void);
+void vnc_runtime_test_rebind(uint64_t head, Error **errp);
+void vnc_runtime_test_display(bool create, Error **errp);
+
+static bool usb_hid_input_test_ready(DeviceState *dev)
+{
+    USBHIDState *us = container_of((HIDState *)dev, USBHIDState, hid);
+
+    return us->input_test_ignore_ready || us->hid.n == 0;
+}
+static void usb_hid_input_test_pending(Object *obj, Visitor *v, const char *name,
+                                      void *opaque, Error **errp)
+{
+    uint64_t value = USB_HID(obj)->hid.n;
+
+    visit_type_uint64(v, name, &value, errp);
+}
+static void usb_hid_input_test_poll(Object *obj, Visitor *v, const char *name,
+                                   void *opaque, Error **errp)
+{
+    uint8_t report[8] = { 0 };
+    uint64_t value = 0;
+    int i;
+
+    hid_keyboard_poll(&USB_HID(obj)->hid, report, sizeof(report));
+    for (i = 0; i < sizeof(report); i++) {
+        value = (value << 8) | report[i];
+    }
+    visit_type_uint64(v, name, &value, errp);
+}
+static void usb_hid_input_test_get_bypass(Object *obj, Visitor *v, const char *name,
+                                         void *opaque, Error **errp)
+{
+    visit_type_bool(v, name, &USB_HID(obj)->input_test_ignore_ready, errp);
+}
+static void usb_hid_input_test_set_bypass(Object *obj, Visitor *v, const char *name,
+                                         void *opaque, Error **errp)
+{
+    visit_type_bool(v, name, &USB_HID(obj)->input_test_ignore_ready, errp);
+}
+static void usb_hid_input_test_visible(Object *obj, Visitor *v, const char *name,
+                                       void *opaque, Error **errp)
+{
+    uint64_t mask = vnc_runtime_test_visible();
+    visit_type_uint64(v, name, &mask, errp);
+}
+static void usb_hid_input_test_slots(Object *obj, Visitor *v, const char *name,
+                                     void *opaque, Error **errp)
+{
+    uint64_t slots = vnc_runtime_test_slots();
+    visit_type_uint64(v, name, &slots, errp);
+}
+static void usb_hid_input_test_rebind(Object *obj, Visitor *v, const char *name,
+                                      void *opaque, Error **errp)
+{
+    uint64_t head = 0;
+    if (visit_type_uint64(v, name, &head, errp)) {
+        vnc_runtime_test_rebind(head, errp);
+    }
+}
+static void usb_hid_input_test_display(Object *obj, Visitor *v, const char *name,
+                                       void *opaque, Error **errp)
+{
+    bool create = false;
+    if (visit_type_bool(v, name, &create, errp)) {
+        vnc_runtime_test_display(create, errp);
+    }
+}
