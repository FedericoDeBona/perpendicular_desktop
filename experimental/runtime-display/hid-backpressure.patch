+/* At most 32 referenced consoles/timers, regardless of repeated display
+ * teardown while the guest is not polling. Full pool rejects new input before
+ * ownership or the guest FIFO changes. No global input queue is reset. */
+#define VNC_INPUT_CLEANUP_SLOTS 32
+typedef struct VncInputCleanup {
+    QemuConsole *con;
+    unsigned int users;
+    uint64_t keyboard_id;
+    DECLARE_BITMAP(keys, KEY_CNT);
+    QEMUTimer *timer;
+} VncInputCleanup;
+static VncInputCleanup vnc_input_cleanups[VNC_INPUT_CLEANUP_SLOTS];
+
+static void vnc_input_cleanup_drain(void *opaque)
+{
+    VncInputCleanup *cleanup = opaque;
+    unsigned int key;
+
+    /* The removed device's releases must never reach a replacement handler. */
+    if (cleanup->keyboard_id != qemu_input_keyboard_id(cleanup->con)) {
+        bitmap_zero(cleanup->keys, KEY_CNT);
+    }
+    for (key = 0; key < KEY_CNT; key++) {
+        if (!test_bit(key, cleanup->keys)) {
+            continue;
+        }
+        if (!qemu_input_keyboard_ready(cleanup->con)) {
+            goto wait;
+        }
+        clear_bit(key, cleanup->keys);
+        qemu_input_event_send_key_linux(cleanup->con, key, false);
+    }
+    /* Also wait for the last emitted release before dropping the console ref. */
+    if (!cleanup->users &&
+        cleanup->keyboard_id == qemu_input_keyboard_id(cleanup->con) &&
+        !qemu_input_keyboard_ready(cleanup->con)) {
+        goto wait;
+    }
+    timer_free(cleanup->timer);
+    cleanup->timer = NULL;
+    if (!cleanup->users) {
+        object_unref(OBJECT(cleanup->con));
+        cleanup->con = NULL;
+    }
+    return;
+wait:
+    timer_mod(cleanup->timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 10);
+}
+
+static bool vnc_input_reserve_cleanup(VncDisplay *vd)
+{
+    VncInputCleanup *free_slot = NULL;
+    unsigned int i;
+
+    if (vd->input_cleanup) {
+        return vd->input_cleanup->keyboard_id == qemu_input_keyboard_id(vd->dcl.con);
+    }
+    for (i = 0; i < VNC_INPUT_CLEANUP_SLOTS; i++) {
+        VncInputCleanup *cleanup = &vnc_input_cleanups[i];
+        if (cleanup->con == vd->dcl.con &&
+            cleanup->keyboard_id == qemu_input_keyboard_id(vd->dcl.con)) {
+            vd->input_cleanup = cleanup;
+            cleanup->users++;
+            return true;
+        }
+        if (!cleanup->con && !free_slot) {
+            free_slot = cleanup;
+        }
+    }
+    if (!free_slot) {
+        return false;
+    }
+    free_slot->con = vd->dcl.con;
+    object_ref(OBJECT(free_slot->con));
+    free_slot->users = 1;
+    free_slot->keyboard_id = qemu_input_keyboard_id(vd->dcl.con);
+    bitmap_zero(free_slot->keys, KEY_CNT);
+    vd->input_cleanup = free_slot;
+    return true;
+}
+
+static void vnc_input_detach_cleanup(VncDisplay *vd)
+{
+    VncInputCleanup *cleanup = vd->input_cleanup;
+
+    if (vd->input_release_timer) {
+        timer_free(vd->input_release_timer);
+        vd->input_release_timer = NULL;
+    }
+    if (!cleanup) {
+        assert(bitmap_empty(vd->input_releases, KEY_CNT));
+        return;
+    }
+    bitmap_or(cleanup->keys, cleanup->keys, vd->input_releases, KEY_CNT);
+    bitmap_zero(vd->input_releases, KEY_CNT);
+    vd->input_cleanup = NULL;
+    assert(cleanup->users > 0);
+    cleanup->users--;
+    if (!cleanup->timer) {
+        cleanup->timer = timer_new_ms(QEMU_CLOCK_REALTIME,
+                                      vnc_input_cleanup_drain, cleanup);
+    }
+    vnc_input_cleanup_drain(cleanup);
+}
