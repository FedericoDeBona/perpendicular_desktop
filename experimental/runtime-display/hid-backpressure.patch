+static bool vnc_input_admit(VncState *vs)
+{
+    if (!vnc_input_reserve_cleanup(vs->vd)) {
+        error_report("VNC keyboard backend changed or cleanup capacity exhausted");
+        vnc_client_error(vs);
+        return false;
+    }
+    /* One 4 KiB socket read plus the largest incomplete key message. Stop
+     * reading while blocked; do not accumulate an unbounded second queue. */
+    if (vs->input.offset > 4096 + 12) {
+        error_report("VNC keyboard backpressure buffer limit exceeded");
+        vnc_client_error(vs);
+        return false;
+    }
+    if (!bitmap_empty(vs->vd->input_cleanup->keys, KEY_CNT)) {
+        vnc_input_cleanup_drain(vs->vd->input_cleanup);
+    }
+    /* A busy surviving client cannot starve a disconnected client's owned
+     * releases by repeatedly taking the next available device slot. */
+    if (!bitmap_empty(vs->vd->input_releases, KEY_CNT)) {
+        vnc_input_release_pending(vs->vd);
+    }
+    if (!qemu_console_is_graphic(vs->vd->dcl.con) ||
+        qemu_input_keyboard_ready(vs->vd->dcl.con)) {
+        return true;
+    }
+    vs->input_blocked = true;
+    vnc_input_schedule_retry(vs);
+    vnc_input_update_watch(vs);
+    return false;
+}
