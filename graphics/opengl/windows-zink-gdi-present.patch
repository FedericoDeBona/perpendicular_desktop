+#ifdef GALLIUM_ZINK
+static void
+wgl_zink_present_readback(struct pipe_context *ctx,
+                          struct pipe_resource *res, HDC hdc)
+{
+   if (!ctx || !res || !res->width0 || !res->height0)
+      return;
+   const unsigned width = res->width0, height = res->height0;
+   if (width > INT_MAX / 4 || height > SIZE_MAX / ((size_t)width * 4))
+      return;
+   const unsigned stride = width * 4;
+   void *pixels = malloc((size_t)stride * height);
+   if (!pixels)
+      return;
+   ctx = threaded_context_unwrap_sync(ctx);
+   struct pipe_transfer *transfer = NULL;
+   void *map = pipe_texture_map(ctx, res, 0, 0, PIPE_MAP_READ,
+                                0, 0, width, height, &transfer);
+   if (map) {
+      bool converted = util_format_translate(PIPE_FORMAT_B8G8R8A8_UNORM,
+                                             pixels, stride, 0, 0,
+                                             res->format, map, transfer->stride,
+                                             0, 0, width, height);
+      pipe_texture_unmap(ctx, transfer);
+      if (converted) {
+         BITMAPINFO info = {0};
+         info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+         info.bmiHeader.biWidth = width;
+         info.bmiHeader.biHeight = -(LONG)height;
+         info.bmiHeader.biPlanes = 1;
+         info.bmiHeader.biBitCount = 32;
+         info.bmiHeader.biCompression = BI_RGB;
+         StretchDIBits(hdc, 0, 0, width, height, 0, 0, width, height,
+                       pixels, &info, DIB_RGB_COLORS, SRCCOPY);
+      }
+   }
+   free(pixels);
+}
+#endif
