--- a/src/gallium/drivers/zink/nir_to_spirv/spirv_builder.c
+++ b/src/gallium/drivers/zink/nir_to_spirv/spirv_builder.c
@@ -200,6 +200,12 @@
 spirv_builder_emit_name(struct spirv_builder *b, SpvId target,
                         const char *name)
 {
+   /* MoltenVK 1.4.2's SPIRV-Cross permits OpName to shadow the Metal
+    * sampler type. Gallium's multisample blitter uses exactly this name,
+    * making the following sampler declaration fail to compile. OpName is
+    * debug metadata: rename it without changing bindings or shader code. */
+   if (!strcmp(name, "sampler"))
+      name = "zink_sampler";
    size_t pos = b->debug_names.num_words;
    spirv_buffer_prepare(&b->debug_names, b->mem_ctx, 2);
    spirv_buffer_emit_word(&b->debug_names, SpvOpName);
