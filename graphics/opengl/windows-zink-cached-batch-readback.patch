+/* Queue bounded color readbacks together. Keep each CPU mapping small, but
+ * wait for one submitted batch instead of serializing once per image band. */
+bool
+zink_wgl_readback_bgra(struct pipe_context *pctx, struct pipe_resource *pres,
+                       void *pixels, unsigned stride, unsigned max_bytes)
+{
+   if (!pres || pres->target != PIPE_TEXTURE_2D || !pres->width0 || !pres->height0 ||
+       pres->depth0 != 1 || pres->array_size != 1 || pres->nr_samples > 1 ||
+       util_format_is_compressed(pres->format) || util_format_is_depth_or_stencil(pres->format))
+      return false;
+   const unsigned row_bytes = util_format_get_stride(pres->format, pres->width0);
+   if (!row_bytes || row_bytes > max_bytes)
+      return false;
+   const unsigned rows_per_band = max_bytes / row_bytes;
+   const unsigned count = (pres->height0 - 1) / rows_per_band + 1;
+   if (count > 16 || (uint64_t)row_bytes * pres->height0 > 32 * 1024 * 1024)
+      return false;
+   struct pipe_resource **bands = calloc(count, sizeof(*bands));
+   if (!bands)
+      return false;
+   void **mapped = calloc(count, sizeof(*mapped));
+   if (!mapped) {free(bands); return false;}
+   struct zink_context *ctx = zink_context(pctx);
+   struct zink_screen *screen = zink_screen(pctx->screen);
+   struct zink_resource *res = zink_resource(pres);
+   bool complete = false;
+   bool cache = sizeof(void *) == 8 && debug_get_bool_option("PERP_WGL_BATCH_CACHE", true);
+   bool mismatch = false;
+   for (unsigned i = 0; i < ARRAY_SIZE(ctx->batch_readback_staging); i++) {
+      struct pipe_resource *saved = ctx->batch_readback_staging[i];
+      if (!saved) continue;
+      if (p_atomic_read(&saved->reference.count) != 1)
+         cache = false;
+      if (i >= count || saved->format != pres->format ||
+          saved->width0 != row_bytes * MIN2(rows_per_band, pres->height0 - i * rows_per_band))
+         mismatch = true;
+   }
+   /* Never overwrite a staging buffer with another live owner. On resize,
+    * replace the idle pool; busy pools use temporary buffers for this frame. */
+   if (cache && mismatch) {
+      for (unsigned i = 0; i < ARRAY_SIZE(ctx->batch_readback_staging); i++) {
+         if (ctx->batch_readback_maps[i])
+            unmap_resource(screen, zink_resource(ctx->batch_readback_staging[i]));
+         ctx->batch_readback_maps[i] = NULL;
+         pipe_resource_reference(&ctx->batch_readback_staging[i], NULL);
+      }
+   }
+   unsigned reused = 0;
+   /* Allocate before recording any copies, so an allocation failure can
+    * return to the existing serial path without a partial submission. */
+   for (unsigned i = 0, y = 0; i < count; i++, y += rows_per_band) {
+      const unsigned rows = MIN2(rows_per_band, pres->height0 - y);
+      struct pipe_resource templ = *pres;
+      templ.next = NULL;
+      templ.usage = PIPE_USAGE_STAGING;
+      templ.target = PIPE_BUFFER;
+      templ.bind = PIPE_BIND_LINEAR;
+      templ.width0 = row_bytes * rows;
+      templ.height0 = templ.depth0 = 0;
+      templ.last_level = 0;
+      templ.array_size = 1;
+      templ.nr_samples = templ.nr_storage_samples = 0;
+      templ.flags = 0;
+      if (cache && ctx->batch_readback_staging[i]) {
+         pipe_resource_reference(&bands[i], ctx->batch_readback_staging[i]);
+         mapped[i] = ctx->batch_readback_maps[i];
+         reused++;
+      } else
+         bands[i] = zink_resource_create(pctx->screen, &templ);
+      if (!bands[i])
+         goto done;
+      /* Venus defers export/page injection until MapMemory. Establish each
+       * bounded mapping before commands can write this presentation batch. */
+      if (!mapped[i])
+         mapped[i] = map_resource(screen, zink_resource(bands[i]));
+      if (!mapped[i])
+         goto done;
+      if (cache && !ctx->batch_readback_staging[i] && zink_resource(bands[i])->obj->coherent) {
+         pipe_resource_reference(&ctx->batch_readback_staging[i], bands[i]);
+         ctx->batch_readback_maps[i] = mapped[i];
+      }
+   }
+   if (reused && !ctx->batch_readback_hits++)
+      mesa_logi("ZINK: bounded batch readback staging reused (%u bands, %llu bytes)",
+                reused, (unsigned long long)row_bytes * pres->height0);
+   struct pipe_box whole;
+   u_box_2d(0, 0, pres->width0, pres->height0, &whole);
+   zink_fb_clears_apply_region(ctx, pres, zink_rect_from_box(&whole), 0, 1);
+   if (zink_resource_usage_is_unflushed_write(res))
+      zink_resource_usage_wait(ctx, res, ZINK_RESOURCE_ACCESS_WRITE);
+   /* All bands belong to the same completed presentation image. Keep their
+    * transitions/copies ordered together, instead of letting subsequent
+    * read-only copies migrate to the unordered command buffer. */
+   const bool saved_no_reorder = ctx->no_reorder;
+   ctx->no_reorder = true;
+   for (unsigned i = 0, y = 0; i < count; i++, y += rows_per_band) {
+      struct zink_transfer trans = {0};
+      trans.base.b.level = 0;
+      trans.base.b.usage = PIPE_MAP_READ;
+      u_box_2d(0, y, pres->width0, MIN2(rows_per_band, pres->height0 - y),
+               &trans.base.b.box);
+      zink_transfer_copy_bufimage(ctx, zink_resource(bands[i]), res, &trans);
+   }
+   ctx->no_reorder = saved_no_reorder;
+   /* The batch retains source/destination resources through completion. */
+   zink_fence_wait(pctx);
+   for (unsigned i = 0, y = 0; i < count; i++, y += rows_per_band) {
+      struct zink_resource *band = zink_resource(bands[i]);
+      const unsigned rows = MIN2(rows_per_band, pres->height0 - y);
+      void *map = mapped[i];
+      bool valid = true;
+      if (!band->obj->coherent) {
+         VkMappedMemoryRange range = zink_resource_init_mem_range(screen, band->obj,
+                                                                 band->obj->offset, band->obj->size);
+         valid = VKSCR(InvalidateMappedMemoryRanges)(screen->dev, 1, &range) == VK_SUCCESS;
+      }
+      if (valid)
+         valid = util_format_translate(PIPE_FORMAT_B8G8R8A8_UNORM,
+                                       (uint8_t *)pixels + (size_t)y * stride, stride, 0, 0,
+                                       pres->format, map, row_bytes, 0, 0, pres->width0, rows);
+      if (!valid)
+         goto done;
+   }
+   complete = true;
+done:
+   for (unsigned i = 0; i < count; i++) {
+      if (mapped[i] && bands[i] != ctx->batch_readback_staging[i])
+         unmap_resource(screen, zink_resource(bands[i]));
+      pipe_resource_reference(&bands[i], NULL);
+   }
+   free(mapped);
+   free(bands);
+   return complete;
+}
