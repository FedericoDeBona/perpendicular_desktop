--- /dev/null
+++ b/src/perp-sync/context-retirement.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: MIT
+ * Private renderer/server agreement. Guest and scanout wire formats are unchanged.
+ */
+#ifndef PERP_CONTEXT_RETIREMENT_H
+#define PERP_CONTEXT_RETIREMENT_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+struct perp_context_retired_reply {uint32_t context_id,stopped;};
+static inline bool perp_context_retirement_enabled(void) {
+    const char *value=getenv("PERP_NEPTUNE_CONTEXT_RETIREMENT");
+    return value && !strcmp(value,"1");
+}
+static inline bool perp_context_reap(pid_t pid) {
+    /* Called by the single server owner after its existing worker SIGKILL.
+     * A timeout or unknown child cannot authorize reuse of the GPU budget. */
+    struct timespec start,current;
+    if(clock_gettime(CLOCK_MONOTONIC,&start))return false;
+    for(;;) {
+        siginfo_t info={0};
+        int result=waitid(P_PID,(id_t)pid,&info,WEXITED|WNOHANG);
+        if(!result && info.si_pid==pid)return true;
+        if(result && errno!=EINTR)return false;
+        if(clock_gettime(CLOCK_MONOTONIC,&current))return false;
+        int64_t elapsed=(int64_t)(current.tv_sec-start.tv_sec)*1000000000ll+current.tv_nsec-start.tv_nsec;
+        if(elapsed>=1000000000ll)return false;
+        usleep(1000);
+    }
+}
+#endif
