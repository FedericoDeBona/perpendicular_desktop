 #include "npt_overrides.h"
+#include "npt_common.h"
+
+/* Diagnostic-only counters: no handles, pointers, names or guest payloads.
+ * Saturate per API at 128 and emit powers of two: at most eight lines/API
+ * per worker process, even with concurrent command rings. */
+static atomic_uint shared_reject_counts[7];
+static const char *const shared_reject_apis[7] = {
+   "IDXGIResource::GetSharedHandle", "IDXGIResource1::CreateSharedHandle",
+   "ID3D11Fence::CreateSharedHandle", "ID3D11Device::OpenSharedResource",
+   "ID3D11Device1::OpenSharedResource1", "ID3D11Device1::OpenSharedResourceByName",
+   "ID3D11Device5::OpenSharedFence",
+};
+
+static void __attribute__((constructor))
+shared_reject_diagnostics_loaded(void)
+{
+   npt_log("shared-handle diagnostics enabled; API/HRESULT only; counters capped at 128");
+}
+
+static void
+shared_reject_diagnostic(unsigned api, HRESULT result)
+{
+   unsigned count = atomic_load_explicit(&shared_reject_counts[api], memory_order_relaxed);
+   while (count < 128 &&
+          !atomic_compare_exchange_weak_explicit(&shared_reject_counts[api], &count, count + 1,
+                                                 memory_order_relaxed, memory_order_relaxed)) {
+   }
+   if (count >= 128)
+      return;
+   count++;
+   if ((count & (count - 1)) == 0)
+      npt_log("shared-handle reject api=%s hr=0x%08x count=%u%s",
+              shared_reject_apis[api], (unsigned)result, count,
+              count == 128 ? " capped=1" : "");
+}
+
 
