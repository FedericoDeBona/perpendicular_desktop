+// VP9 output stays on the GPU. This synchronous transfer deliberately keeps
+// the existing EndFrame completion contract and does not introduce new fences.
+#import <CoreVideo/CoreVideo.h>
+#include "d3d11_video_vt.hpp"
+struct NativeFrameCopy {
+ id<MTLDevice> device=nil;
+ id<MTLCommandQueue> queue=nil;
+ CVMetalTextureCacheRef cache=nullptr;
+};
+void *NativeVideoFrameCopyCreate(uint64_t destination) {
+ @autoreleasepool {
+  auto target=(id<MTLTexture>)(uintptr_t)destination;
+  if(!target)return nullptr;
+  auto copy=new NativeFrameCopy;
+  copy->device=[target.device retain];
+  copy->queue=[copy->device newCommandQueue];
+  if(!copy->queue || CVMetalTextureCacheCreate(kCFAllocatorDefault,nullptr,copy->device,nullptr,&copy->cache)!=kCVReturnSuccess) {
+   NativeVideoFrameCopyDestroy(copy);return nullptr;
+  }
+  return copy;
+ }
+}
+void NativeVideoFrameCopyDestroy(void *ptr) {
+ auto copy=static_cast<NativeFrameCopy*>(ptr);if(!copy)return;
+ if(copy->cache)CFRelease(copy->cache);
+ [copy->queue release];[copy->device release];delete copy;
+}
+bool NativeVideoFrameCopy(void *ptr,void *image,uint64_t luma,uint64_t chroma,unsigned slice) {
+ auto copy=static_cast<NativeFrameCopy*>(ptr);auto pixel=(CVPixelBufferRef)image;
+ if(!copy||!pixel||!luma||!chroma||CVPixelBufferGetPlaneCount(pixel)!=2)return false;
+ @autoreleasepool {
+  id<MTLTexture> targets[2]={(id<MTLTexture>)(uintptr_t)luma,(id<MTLTexture>)(uintptr_t)chroma};
+  CVMetalTextureRef planes[2]={nullptr,nullptr};
+  bool valid=true;
+  for(unsigned i=0;i<2;i++){
+   auto t=targets[i];auto format=i?MTLPixelFormatRG8Unorm:MTLPixelFormatR8Unorm;
+   auto width=CVPixelBufferGetWidthOfPlane(pixel,i),height=CVPixelBufferGetHeightOfPlane(pixel,i);
+   if(t.device!=copy->device||t.pixelFormat!=format||t.width!=width||t.height!=height||slice>=t.arrayLength||
+      (t.textureType!=MTLTextureType2D&&t.textureType!=MTLTextureType2DArray)||
+      CVMetalTextureCacheCreateTextureFromImage(kCFAllocatorDefault,copy->cache,pixel,nullptr,format,width,height,i,&planes[i])!=kCVReturnSuccess){valid=false;break;}
+  }
+  if(valid){
+   auto command=[copy->queue commandBuffer];auto blit=[command blitCommandEncoder];
+   if(!blit)valid=false;
+   else {
+    for(unsigned i=0;i<2;i++){
+     auto source=CVMetalTextureGetTexture(planes[i]);
+     [blit copyFromTexture:source sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0)
+       sourceSize:MTLSizeMake(source.width,source.height,1) toTexture:targets[i]
+       destinationSlice:slice destinationLevel:0 destinationOrigin:MTLOriginMake(0,0,0)];
+    }
+    [blit endEncoding];[command commit];[command waitUntilCompleted];
+    valid=command.status==MTLCommandBufferStatusCompleted;
+   }
+  }
+  // Keep CoreVideo wrappers (and the decoded IOSurface) alive through completion.
+  for(auto plane:planes)if(plane)CFRelease(plane);
+  return valid;
+ }
