+// Native VP9 profile-0 session. Kept separate from the Windows COM headers.
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#include "d3d11_video_vt.hpp"
+#include <VideoToolbox/VideoToolbox.h>
+#include <CoreMedia/CoreMedia.h>
+#include <CoreVideo/CoreVideo.h>
+#include <cstring>
+#include <mutex>
+
+namespace dxmt {
+bool NativeVP9HardwareAvailable() {
+  static std::once_flag once;
+  std::call_once(once, [] { VTRegisterSupplementalVideoDecoderIfAvailable(kCMVideoCodecType_VP9); });
+  return VTIsHardwareDecodeSupported(kCMVideoCodecType_VP9);
+}
+struct NativeVP9Session::Impl {
+  unsigned width, height;
+  CMVideoFormatDescriptionRef format = nullptr;
+  VTDecompressionSessionRef session = nullptr;
+  CVPixelBufferRef output = nullptr;
+  OSStatus output_status = noErr;
+  bool hardware = false;
+  Impl(unsigned w, unsigned h) : width(w), height(h) {
+    if (!NativeVP9HardwareAvailable()) return;
+    uint8_t config[] = {1,0,0,0,0,0,0x82,2,2,2,0,0};
+    CFDataRef data = CFDataCreate(kCFAllocatorDefault, config, sizeof(config));
+    const void *atom_keys[] = {CFSTR("vpcC")}, *atom_values[] = {data};
+    auto atoms = CFDictionaryCreate(kCFAllocatorDefault, atom_keys, atom_values, 1,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    const void *ext_keys[] = {kCMFormatDescriptionExtension_SampleDescriptionExtensionAtoms}, *ext_values[] = {atoms};
+    auto extensions = CFDictionaryCreate(kCFAllocatorDefault, ext_keys, ext_values, 1,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    auto status = CMVideoFormatDescriptionCreate(kCFAllocatorDefault, kCMVideoCodecType_VP9,
+        width, height, extensions, &format);
+    CFRelease(extensions); CFRelease(atoms); CFRelease(data);
+    if (status != noErr) return;
+    const void *spec_keys[] = {kVTVideoDecoderSpecification_RequireHardwareAcceleratedVideoDecoder};
+    const void *spec_values[] = {kCFBooleanTrue};
+    auto spec = CFDictionaryCreate(kCFAllocatorDefault, spec_keys, spec_values, 1,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    int pixel_format = kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+    auto number = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &pixel_format);
+    auto surface = CFDictionaryCreate(kCFAllocatorDefault, nullptr, nullptr, 0,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    const void *attr_keys[] = {kCVPixelBufferPixelFormatTypeKey, kCVPixelBufferMetalCompatibilityKey,
+                              kCVPixelBufferIOSurfacePropertiesKey};
+    const void *attr_values[] = {number, kCFBooleanTrue, surface};
+    auto attrs = CFDictionaryCreate(kCFAllocatorDefault, attr_keys, attr_values, 3,
+        &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    VTDecompressionOutputCallbackRecord callback = {
+      [](void *opaque, void *, OSStatus result, VTDecodeInfoFlags, CVImageBufferRef image, CMTime, CMTime) {
+        auto self = static_cast<Impl *>(opaque);
+        self->output_status = result;
+        if (self->output) CFRelease(self->output);
+        self->output = image ? CVPixelBufferRetain(image) : nullptr;
+      }, this
+    };
+    status = VTDecompressionSessionCreate(kCFAllocatorDefault, format, spec, attrs, &callback, &session);
+    CFRelease(attrs); CFRelease(surface); CFRelease(number); CFRelease(spec);
+    if (status != noErr || !session) return;
+    CFTypeRef accelerated = nullptr;
+    status = VTSessionCopyProperty(session, kVTDecompressionPropertyKey_UsingHardwareAcceleratedVideoDecoder,
+                                  kCFAllocatorDefault, &accelerated);
+    hardware = status == noErr && accelerated && CFEqual(accelerated, kCFBooleanTrue);
+    if (accelerated) CFRelease(accelerated);
+  }
+  ~Impl() {
+    if (session) { VTDecompressionSessionInvalidate(session); CFRelease(session); }
+    if (output) CFRelease(output);
+    if (format) CFRelease(format);
+  }
+};
+NativeVP9Session::NativeVP9Session(unsigned w, unsigned h) : impl_(new Impl(w,h)) {}
+NativeVP9Session::~NativeVP9Session() = default;
+bool NativeVP9Session::ready() const { return impl_->session && impl_->hardware; }
+bool NativeVP9Session::decode(const uint8_t *bytes, size_t size, std::vector<uint8_t> &nv12) {
+  if (!ready() || !bytes || !size || size > 16 * 1024 * 1024 || (bytes[0] & 0xf0) != 0x80) return false;
+  auto &s = *impl_;
+  if (s.output) { CFRelease(s.output); s.output = nullptr; }
+  s.output_status = noErr;
+  CMBlockBufferRef block = nullptr;
+  auto status = CMBlockBufferCreateWithMemoryBlock(kCFAllocatorDefault, nullptr, size,
+      kCFAllocatorDefault, nullptr, 0, size, 0, &block);
+  if (status != noErr) return false;
+  status = CMBlockBufferReplaceDataBytes(bytes, block, 0, size);
+  CMSampleBufferRef sample = nullptr;
+  if (status == noErr) status = CMSampleBufferCreateReady(kCFAllocatorDefault, block, s.format,
+      1, 0, nullptr, 1, &size, &sample);
+  if (status == noErr) status = VTDecompressionSessionDecodeFrame(s.session, sample, 0, nullptr, nullptr);
+  // The callback's image is retained until the next decode/destruction.
+  auto wait_status = VTDecompressionSessionWaitForAsynchronousFrames(s.session);
+  if (sample) CFRelease(sample);
+  CFRelease(block);
+  if (status != noErr || wait_status != noErr || s.output_status != noErr || !s.output) return false;
+  auto image = s.output;
+  if (CVPixelBufferGetWidth(image) != s.width || CVPixelBufferGetHeight(image) != s.height ||
+      CVPixelBufferGetPixelFormatType(image) != kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange ||
+      CVPixelBufferGetPlaneCount(image) != 2) return false;
+  nv12.resize(size_t(s.width) * s.height * 3 / 2);
+  if (CVPixelBufferLockBaseAddress(image, kCVPixelBufferLock_ReadOnly) != kCVReturnSuccess) return false;
+  size_t offset = 0;
+  bool valid = true;
+  for (unsigned plane = 0; plane < 2; ++plane) {
+    auto base = static_cast<const uint8_t *>(CVPixelBufferGetBaseAddressOfPlane(image, plane));
+    auto rows = plane ? s.height / 2 : s.height;
+    auto pitch = CVPixelBufferGetBytesPerRowOfPlane(image, plane);
+    if (!base || pitch < s.width || CVPixelBufferGetHeightOfPlane(image, plane) != rows) { valid = false; break; }
+    for (unsigned row = 0; row < rows; ++row) {
+      std::memcpy(nv12.data() + offset, base + row * pitch, s.width);
+      offset += s.width;
+    }
+  }
+  CVPixelBufferUnlockBaseAddress(image, kCVPixelBufferLock_ReadOnly);
+  return valid;
+}
