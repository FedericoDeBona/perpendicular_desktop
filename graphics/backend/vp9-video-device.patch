+  Decoder(MTLD3D11Device *dev, const D3D11_VIDEO_DECODER_DESC &d, const D3D11_VIDEO_DECODER_CONFIG &c)
+    : MTLD3D11DeviceChild(dev), owner_(dev), session(d.SampleWidth, d.SampleHeight), desc(d), config(c) {}
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID id, void **out) override {
+    if (!out) return E_POINTER;
+    *out = nullptr;
+    if (id == __uuidof(IUnknown) || id == __uuidof(ID3D11DeviceChild) || id == __uuidof(ID3D11VideoDecoder)) {
+      *out = ref(this); return S_OK;
+    }
+    return E_NOINTERFACE;
+  }
