+class VideoDevice final : public UnsupportedDevice {
+  MTLD3D11Device *device_;
+  ComPrivateData private_;
+public:
+  explicit VideoDevice(MTLD3D11Device *dev) : device_(dev) {}
+  ULONG STDMETHODCALLTYPE AddRef() override { return device_->AddRef(); }
+  ULONG STDMETHODCALLTYPE Release() override { return device_->Release(); }
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID id, void **out) override {
+    if (!out) return E_POINTER;
+    if (id == __uuidof(ID3D11VideoDevice)) { *out = ref(this); return S_OK; }
+    return device_->QueryInterface(id, out);
+  }
+  HRESULT STDMETHODCALLTYPE SetPrivateData(REFGUID id, UINT size, const void *data) override {
+    return private_.setData(id, size, data);
+  }
+  HRESULT STDMETHODCALLTYPE SetPrivateDataInterface(REFGUID id, const IUnknown *value) override {
+    return private_.setInterface(id, value);
+  }
+  UINT STDMETHODCALLTYPE GetVideoDecoderProfileCount() override { return 1; }
+  HRESULT STDMETHODCALLTYPE GetVideoDecoderProfile(UINT index, GUID *profile) override {
+    if (!profile) return E_POINTER;
+    *profile = {};
+    if (index) return E_INVALIDARG;
+    *profile = VP9Profile0; return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE CheckVideoDecoderFormat(const GUID *profile, DXGI_FORMAT format, WINBOOL *supported) override {
+    if (!profile || !supported) return E_POINTER;
+    *supported = *profile == VP9Profile0 && format == DXGI_FORMAT_NV12;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE GetVideoDecoderConfigCount(const D3D11_VIDEO_DECODER_DESC *desc, UINT *count) override {
+    if (!count) return E_POINTER;
+    *count = 0;
+    if (!validDesc(desc)) return E_INVALIDARG;
+    *count = 1; return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE GetVideoDecoderConfig(const D3D11_VIDEO_DECODER_DESC *desc, UINT index,
+                                                 D3D11_VIDEO_DECODER_CONFIG *config) override {
+    if (!config) return E_POINTER;
+    *config = {};
+    if (!validDesc(desc) || index) return E_INVALIDARG;
+    *config = decoderConfig(); return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE CreateVideoDecoder(const D3D11_VIDEO_DECODER_DESC *desc,
+      const D3D11_VIDEO_DECODER_CONFIG *config, ID3D11VideoDecoder **out) override {
+    if (!out) return E_POINTER;
+    *out = nullptr;
+    auto expected = decoderConfig();
+    if (!validDesc(desc) || !config || std::memcmp(config, &expected, sizeof(expected))) return E_INVALIDARG;
+    try {
+      auto decoder = std::make_unique<Decoder>(device_, *desc, *config);
+      if (!decoder->session.ready()) return E_FAIL;
+      *out = ref(decoder.release()); return S_OK;
+    } catch (const std::bad_alloc &) { return E_OUTOFMEMORY; }
+  }
+  HRESULT STDMETHODCALLTYPE CreateVideoDecoderOutputView(ID3D11Resource *resource,
+      const D3D11_VIDEO_DECODER_OUTPUT_VIEW_DESC *desc, ID3D11VideoDecoderOutputView **out) override {
+    if (!out) return E_POINTER;
+    *out = nullptr;
+    if (!resource || !desc || desc->DecodeProfile != VP9Profile0 || desc->ViewDimension != D3D11_VDOV_DIMENSION_TEXTURE2D)
+      return E_INVALIDARG;
+    Com<ID3D11Texture2D> texture;
+    if (FAILED(resource->QueryInterface(__uuidof(ID3D11Texture2D), reinterpret_cast<void **>(&texture)))) return E_INVALIDARG;
+    Com<ID3D11Device> owner; texture->GetDevice(&owner);
+    if (owner.ptr() != device_) return E_INVALIDARG;
+    D3D11_TEXTURE2D_DESC td = {}; texture->GetDesc(&td);
+    if (td.Format != DXGI_FORMAT_NV12 || td.MipLevels != 1 || td.SampleDesc.Count != 1 ||
+        td.Usage != D3D11_USAGE_DEFAULT || !(td.BindFlags & D3D11_BIND_DECODER) || desc->Texture2D.ArraySlice >= td.ArraySize)
+      return E_INVALIDARG;
+    try { *out = ref(new DecoderView(device_, texture.ptr(), *desc)); return S_OK; }
+    catch (const std::bad_alloc &) { return E_OUTOFMEMORY; }
+  }
+};
