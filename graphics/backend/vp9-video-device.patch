+  ULONG STDMETHODCALLTYPE Release() override { return context_->Release(); }
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID id, void **out) override {
+    if (!out) return E_POINTER;
+    if (id == __uuidof(ID3D11VideoContext)) { *out = ref(this); return S_OK; }
+    return context_->QueryInterface(id, out);
+  }
+  void STDMETHODCALLTYPE GetDevice(ID3D11Device **out) override { context_->GetDevice(out); }
+  HRESULT STDMETHODCALLTYPE GetPrivateData(REFGUID id, UINT *size, void *data) override { return context_->GetPrivateData(id,size,data); }
+  HRESULT STDMETHODCALLTYPE SetPrivateData(REFGUID id, UINT size, const void *data) override { return context_->SetPrivateData(id,size,data); }
+  HRESULT STDMETHODCALLTYPE SetPrivateDataInterface(REFGUID id, const IUnknown *value) override { return context_->SetPrivateDataInterface(id,value); }
+  HRESULT STDMETHODCALLTYPE DecoderBeginFrame(ID3D11VideoDecoder *d, ID3D11VideoDecoderOutputView *v,
+                                              UINT key_size, const void *key) override {
+    auto decoder = checked(d); auto view = dynamic_cast<DecoderView *>(v);
+    if (!decoder || !view || view->device() != device_) return E_INVALIDARG;
+    if (key_size || key) return E_NOTIMPL;
+    std::lock_guard<std::mutex> lock(decoder->mutex);
+    if (decoder->active_context) return DXGI_ERROR_WAS_STILL_DRAWING;
+    D3D11_TEXTURE2D_DESC td = {}; view->texture()->GetDesc(&td);
+    if (td.Width != decoder->desc.SampleWidth || td.Height != decoder->desc.SampleHeight) return E_INVALIDARG;
+    decoder->view = view; decoder->active_context = context_; decoder->submitted.clear();
+    for (auto &b : decoder->buffers) b.mapped = false;
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE GetDecoderBuffer(ID3D11VideoDecoder *d, D3D11_VIDEO_DECODER_BUFFER_TYPE type,
+                                             UINT *size, void **out) override {
+    if (!size || !out) return E_POINTER;
+    *size = 0; *out = nullptr;
+    auto decoder = checked(d); int index = Decoder::bufferIndex(type);
+    if (!decoder || index < 0) return E_INVALIDARG;
+    std::lock_guard<std::mutex> lock(decoder->mutex);
+    if (decoder->active_context != context_) return E_INVALIDARG;
+    auto &buffer = decoder->buffers[index];
+    if (buffer.mapped) return DXGI_ERROR_WAS_STILL_DRAWING;
+    try { buffer.bytes.resize(index ? 64 * 1024 : 16 * 1024 * 1024); }
+    catch (const std::bad_alloc &) { return E_OUTOFMEMORY; }
+    buffer.mapped = true; *size = buffer.bytes.size(); *out = buffer.bytes.data(); return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE ReleaseDecoderBuffer(ID3D11VideoDecoder *d, D3D11_VIDEO_DECODER_BUFFER_TYPE type) override {
+    auto decoder = checked(d); int index = Decoder::bufferIndex(type);
+    if (!decoder || index < 0) return E_INVALIDARG;
+    std::lock_guard<std::mutex> lock(decoder->mutex);
+    if (decoder->active_context != context_ || !decoder->buffers[index].mapped) return E_INVALIDARG;
+    decoder->buffers[index].mapped = false; return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE SubmitDecoderBuffers(ID3D11VideoDecoder *d, UINT count,
+                                                  const D3D11_VIDEO_DECODER_BUFFER_DESC *descs) override {
+    auto decoder = checked(d);
+    if (!decoder || !count || count > 3 || !descs) return E_INVALIDARG;
+    std::lock_guard<std::mutex> lock(decoder->mutex);
+    if (decoder->active_context != context_) return E_INVALIDARG;
+    const D3D11_VIDEO_DECODER_BUFFER_DESC *bitstream = nullptr;
+    for (UINT i = 0; i < count; ++i) {
+      auto &desc = descs[i]; int index = Decoder::bufferIndex(desc.BufferType);
+      if (index < 0 || desc.BufferIndex || desc.ReservedBits) return E_INVALIDARG;
+      if (desc.pIV || desc.IVSize || desc.PartialEncryption || desc.EncryptedBlockInfo.NumEncryptedBytesAtBeginning ||
+          desc.EncryptedBlockInfo.NumBytesInSkipPattern || desc.EncryptedBlockInfo.NumBytesInEncryptPattern)
+        return E_NOTIMPL;
+      auto &buffer = decoder->buffers[index];
+      if (buffer.mapped || desc.DataOffset > buffer.bytes.size() || desc.DataSize > buffer.bytes.size() - desc.DataOffset)
+        return E_INVALIDARG;
+      if (!index) {
+        if (bitstream || !decoder->submitted.empty() || !desc.DataSize) return E_INVALIDARG;
+        bitstream = &desc;
+      }
+    }
+    if (bitstream) {
+      auto &buffer = decoder->buffers[0].bytes;
+      try { decoder->submitted.assign(buffer.begin() + bitstream->DataOffset,
+                                       buffer.begin() + bitstream->DataOffset + bitstream->DataSize); }
+      catch (const std::bad_alloc &) { return E_OUTOFMEMORY; }
+    }
+    return S_OK;
+  }
+  HRESULT STDMETHODCALLTYPE DecoderEndFrame(ID3D11VideoDecoder *d) override {
+    auto decoder = checked(d);
+    if (!decoder) return E_INVALIDARG;
+    std::lock_guard<std::mutex> lock(decoder->mutex);
+    if (decoder->active_context != context_) return E_INVALIDARG;
+    auto view = std::move(decoder->view); decoder->active_context = nullptr;
+    for (auto &buffer : decoder->buffers) if (buffer.mapped) return E_INVALIDARG;
+    if (!view || decoder->submitted.empty()) return E_INVALIDARG;
+    try {
+      if (!decoder->session.decode(decoder->submitted.data(), decoder->submitted.size(), decoder->pixels)) return E_FAIL;
+      context_->UpdateSubresource(view->texture(), view->slice(), nullptr, decoder->pixels.data(), decoder->desc.SampleWidth, 0);
+    } catch (const std::bad_alloc &) { return E_OUTOFMEMORY; }
+    return S_OK;
+  }
+};
+} // namespace
+std::unique_ptr<NativeVideoDevice> CreateNativeVideoDevice(MTLD3D11Device *device) {
+  return NativeVP9HardwareAvailable() ? std::make_unique<VideoDevice>(device) : nullptr;
+}
+std::unique_ptr<NativeVideoContext> CreateNativeVideoContext(MTLD3D11Device *device, ID3D11DeviceContext *context) {
+  if (context->GetType() != D3D11_DEVICE_CONTEXT_IMMEDIATE || !NativeVP9HardwareAvailable()) return nullptr;
+  return std::make_unique<VideoContext>(device,context);
+}
