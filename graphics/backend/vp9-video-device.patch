+  MTLD3D11Device *device() const { return m_parent; }
+  static int bufferIndex(D3D11_VIDEO_DECODER_BUFFER_TYPE t) {
+    switch (t) {
+      case D3D11_VIDEO_DECODER_BUFFER_BITSTREAM: return 0;
+      case D3D11_VIDEO_DECODER_BUFFER_PICTURE_PARAMETERS: return 1;
