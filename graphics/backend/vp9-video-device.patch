+constexpr GUID VP9Profile0 = {0x463707f8,0xa1d0,0x4585,{0x87,0x6d,0x83,0xaa,0x6d,0x60,0xb8,0x9e}};
+constexpr GUID NoEncrypt = {0x1b81bed0,0xa0c7,0x11d3,{0xb9,0x84,0x00,0xc0,0x4f,0x2e,0x73,0xc5}};
+bool validDesc(const D3D11_VIDEO_DECODER_DESC *d) {
+  return d && d->Guid == VP9Profile0 && d->OutputFormat == DXGI_FORMAT_NV12 &&
+      d->SampleWidth && d->SampleHeight && !(d->SampleWidth & 1) && !(d->SampleHeight & 1) &&
+      d->SampleWidth <= 4096 && d->SampleHeight <= 2160;
+}
+D3D11_VIDEO_DECODER_CONFIG decoderConfig() {
+  D3D11_VIDEO_DECODER_CONFIG c = {};
+  c.guidConfigBitstreamEncryption = c.guidConfigMBcontrolEncryption = c.guidConfigResidDiffEncryption = NoEncrypt;
+  c.ConfigBitstreamRaw = 1;
+  c.ConfigMinRenderTargetBuffCount = 8;
+  return c;
+}
