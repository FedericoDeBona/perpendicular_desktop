+class DecoderView final : public MTLD3D11DeviceChild<ID3D11VideoDecoderOutputView> {
+  Com<ID3D11Device> owner_;
+  Com<ID3D11Texture2D> texture_;
+  D3D11_VIDEO_DECODER_OUTPUT_VIEW_DESC desc_;
+public:
+  DecoderView(MTLD3D11Device *dev, ID3D11Texture2D *texture, const D3D11_VIDEO_DECODER_OUTPUT_VIEW_DESC &desc)
+    : MTLD3D11DeviceChild(dev), owner_(dev), texture_(texture), desc_(desc) {}
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID id, void **out) override {
+    if (!out) return E_POINTER;
+    *out = nullptr;
+    if (id == __uuidof(IUnknown) || id == __uuidof(ID3D11DeviceChild) ||
+        id == __uuidof(ID3D11View) || id == __uuidof(ID3D11VideoDecoderOutputView)) {
+      *out = ref(this); return S_OK;
+    }
+    return E_NOINTERFACE;
+  }
+  void STDMETHODCALLTYPE GetResource(ID3D11Resource **out) override { if (out) *out = ref(texture_.ptr()); }
+  void STDMETHODCALLTYPE GetDesc(D3D11_VIDEO_DECODER_OUTPUT_VIEW_DESC *out) override { if (out) *out = desc_; }
+  MTLD3D11Device *device() const { return m_parent; }
+  ID3D11Texture2D *texture() const { return texture_.ptr(); }
+  UINT slice() const { return desc_.Texture2D.ArraySlice; }
+};
