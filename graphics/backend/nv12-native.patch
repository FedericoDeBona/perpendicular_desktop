+inline bool
+ValidateNV12Map(ID3D11Resource *resource, UINT subresource, D3D11_MAP mapType) {
+  D3D11_RESOURCE_DIMENSION dimension;
+  resource->GetType(&dimension);
+  if (dimension != D3D11_RESOURCE_DIMENSION_TEXTURE2D)
+    return true;
+  D3D11_TEXTURE2D_DESC desc;
+  static_cast<ID3D11Texture2D *>(resource)->GetDesc(&desc);
+  if (desc.Format != DXGI_FORMAT_NV12)
+    return true;
+  if (subresource >= 2 * desc.ArraySize)
+    return false;
+  if (desc.Usage == D3D11_USAGE_DYNAMIC)
+    return mapType == D3D11_MAP_WRITE_DISCARD;
+  if (desc.Usage != D3D11_USAGE_STAGING || mapType < D3D11_MAP_READ || mapType > D3D11_MAP_READ_WRITE)
+    return false;
+  return (!(mapType & D3D11_MAP_READ) || (desc.CPUAccessFlags & D3D11_CPU_ACCESS_READ)) &&
+         (!(mapType & D3D11_MAP_WRITE) || (desc.CPUAccessFlags & D3D11_CPU_ACCESS_WRITE));
+}
+
+inline UINT
+NV12MapRows(ID3D11Resource *resource, UINT subresource) {
+  D3D11_RESOURCE_DIMENSION dimension;
+  resource->GetType(&dimension);
+  if (dimension == D3D11_RESOURCE_DIMENSION_TEXTURE2D) {
+    D3D11_TEXTURE2D_DESC desc;
+    static_cast<ID3D11Texture2D *>(resource)->GetDesc(&desc);
+    if (desc.Format == DXGI_FORMAT_NV12 && subresource >= desc.ArraySize && subresource < 2 * desc.ArraySize)
+      return desc.Height;
+  }
+  return 0;
+}
