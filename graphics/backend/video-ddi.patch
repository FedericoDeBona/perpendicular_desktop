+    }
+}
+void tritonInstallVideoFuncs(PTRITON_DEVICE p, const D3D10DDIARG_CREATEDEVICE *args) {
+    if (!args->ppfnRetrieveSubObject) return;
+    HRESULT hr = ID3D11Device1_QueryInterface(p->pDev1, &IID_ID3D11VideoDevice, (void **)&p->pVideoDev);
+    if (SUCCEEDED(hr)) hr = ID3D11DeviceContext1_QueryInterface(p->pCtx1, &IID_ID3D11VideoContext, (void **)&p->pVideoCtx);
+    if (FAILED(hr)) { tritonDestroyVideo(p); return; }
+    *args->ppfnRetrieveSubObject = videoRetrieve;
+}
+void tritonDestroyVideo(PTRITON_DEVICE p) {
+    if (p->pVideoCtx) { ID3D11VideoContext_Release(p->pVideoCtx); p->pVideoCtx = NULL; }
+    if (p->pVideoDev) { ID3D11VideoDevice_Release(p->pVideoDev); p->pVideoDev = NULL; }
+}
+
+BOOL tritonVideoFormatSupported(PTRITON_DEVICE p, DXGI_FORMAT fmt) {
+    if (!p || !p->pVideoDev) return FALSE;
+    UINT count = ID3D11VideoDevice_GetVideoDecoderProfileCount(p->pVideoDev);
+    for (UINT i = 0; i < count; i++) {
+        GUID profile; BOOL supported = FALSE;
+        if (SUCCEEDED(ID3D11VideoDevice_GetVideoDecoderProfile(p->pVideoDev, i, &profile)) &&
+            SUCCEEDED(ID3D11VideoDevice_CheckVideoDecoderFormat(p->pVideoDev, &profile, fmt, &supported)) && supported) return TRUE;
+    }
+    return FALSE;
+}
