+/* SPDX-License-Identifier: MIT
+ * VP9 profile-0 decoding through the paired native video backend.
+ * Compressed buffers remain D3D resources across the existing Neptune wire.
+ */
+#include "triton.h"
+#include "npt_common.h"
+#include "video-resource-submit.h"
+#include "tritonVideoStubs.h"
+
+typedef struct { ID3D11VideoDecoder *object; } TRITON_VIDEO_DECODER;
+typedef struct { ID3D11VideoDecoderOutputView *object; } TRITON_VIDEO_OUTPUT;
+_Static_assert(sizeof(D3D11_VIDEO_DECODER_DESC) == sizeof(D3D11_1DDI_VIDEO_DECODER_DESC), "decoder desc ABI");
+_Static_assert(sizeof(D3D11_VIDEO_DECODER_CONFIG) == sizeof(D3D11_1DDI_VIDEO_DECODER_CONFIG), "decoder config ABI");
+
+static PTRITON_DEVICE videoDevice(D3D10DDI_HDEVICE h) { return h.pDrvPrivate; }
+static ID3D11VideoDecoder *videoDecoder(D3D11_1DDI_HDECODE h) {
+    return h.pDrvPrivate ? ((TRITON_VIDEO_DECODER *)h.pDrvPrivate)->object : NULL;
+}
+static HRESULT videoCommand(PTRITON_DEVICE p, ID3D11VideoDecoder *d, UINT f,
+    void *input, UINT size, ID3D11Resource **resources, UINT count) {
+    if (!p || !p->pVideoCtx || !d) return E_INVALIDARG;
+    D3D11_VIDEO_DECODER_EXTENSION e = {0};
+    e.Function = f; e.pPrivateInputData = input; e.PrivateInputDataSize = size;
+    e.ResourceCount = count; e.ppResourceList = resources;
+    return ID3D11VideoContext_DecoderExtension(p->pVideoCtx, d, &e);
+}
+static BOOL videoDesc(PTRITON_DEVICE p, const D3D11_1DDI_VIDEO_DECODER_DESC *desc) {
+    UINT count = 0; D3D11_VIDEO_DECODER_DESC native;
+    if (!p || !p->pVideoDev || !desc) return FALSE;
+    memcpy(&native, desc, sizeof(native));
+    return SUCCEEDED(ID3D11VideoDevice_GetVideoDecoderConfigCount(p->pVideoDev, &native, &count)) && count;
+}
+static VOID APIENTRY videoProfileCount(D3D10DDI_HDEVICE h, UINT *count) {
+    PTRITON_DEVICE p = videoDevice(h);
+    if (count) *count = p && p->pVideoDev ? ID3D11VideoDevice_GetVideoDecoderProfileCount(p->pVideoDev) : 0;
+}
+static VOID APIENTRY videoProfile(D3D10DDI_HDEVICE h, UINT i, GUID *out) {
+    PTRITON_DEVICE p = videoDevice(h); if (!out) return; memset(out, 0, sizeof(*out));
+    if (p && p->pVideoDev) ID3D11VideoDevice_GetVideoDecoderProfile(p->pVideoDev, i, out);
+}
+static VOID APIENTRY videoFormat(D3D10DDI_HDEVICE h, const GUID *profile, DXGI_FORMAT fmt, BOOL *out) {
+    PTRITON_DEVICE p = videoDevice(h); if (!out) return; *out = FALSE;
+    if (p && p->pVideoDev && profile) ID3D11VideoDevice_CheckVideoDecoderFormat(p->pVideoDev, profile, fmt, out);
+}
+static VOID APIENTRY videoConfigCount(D3D10DDI_HDEVICE h, const D3D11_1DDI_VIDEO_DECODER_DESC *desc, UINT *out) {
+    PTRITON_DEVICE p = videoDevice(h); D3D11_VIDEO_DECODER_DESC native;
+    if (!out) return; *out = 0; if (!p || !p->pVideoDev || !desc) return;
+    memcpy(&native, desc, sizeof(native)); ID3D11VideoDevice_GetVideoDecoderConfigCount(p->pVideoDev, &native, out);
+}
+static VOID APIENTRY videoConfig(D3D10DDI_HDEVICE h, const D3D11_1DDI_VIDEO_DECODER_DESC *desc, UINT i, D3D11_1DDI_VIDEO_DECODER_CONFIG *out) {
+    PTRITON_DEVICE p = videoDevice(h); D3D11_VIDEO_DECODER_DESC native; D3D11_VIDEO_DECODER_CONFIG config = {0};
+    if (!out) return; memset(out, 0, sizeof(*out)); if (!p || !p->pVideoDev || !desc) return;
+    memcpy(&native, desc, sizeof(native));
+    if (SUCCEEDED(ID3D11VideoDevice_GetVideoDecoderConfig(p->pVideoDev, &native, i, &config))) memcpy(out, &config, sizeof(config));
+}
+static VOID APIENTRY videoBufferCount(D3D10DDI_HDEVICE h, const D3D11_1DDI_VIDEO_DECODER_DESC *desc, UINT *out) {
+    if (out) *out = videoDesc(videoDevice(h), desc) ? 3 : 0;
+}
+static VOID APIENTRY videoBufferInfo(D3D10DDI_HDEVICE h, const D3D11_1DDI_VIDEO_DECODER_DESC *desc, UINT i, D3D11_1DDI_VIDEO_DECODER_BUFFER_INFO *out) {
+    static const D3D11_1DDI_VIDEO_DECODER_BUFFER_TYPE types[3] = {
+        D3D11_1DDI_VIDEO_DECODER_BUFFER_PICTURE_PARAMETERS, D3D11_1DDI_VIDEO_DECODER_BUFFER_SLICE_CONTROL, D3D11_1DDI_VIDEO_DECODER_BUFFER_BITSTREAM };
+    if (!out) return; memset(out, 0, sizeof(*out)); if (i >= 3 || !videoDesc(videoDevice(h), desc)) return;
+    out->Type = types[i]; out->Size = i == 2 ? PERP_VIDEO_MAX_BITSTREAM : PERP_VIDEO_MAX_METADATA;
+    out->Usage = D3D11_1DDI_VIDEO_USAGE_OPTIMAL_QUALITY;
+    npt_log("video: buffer info index=%u type=%u size=%u usage=%u", i, (unsigned)out->Type, out->Size, out->Usage);
+}
+static SIZE_T APIENTRY videoDecoderSize(D3D10DDI_HDEVICE h, const D3D11_1DDIARG_CREATEVIDEODECODER *args) {
+    npt_log("video: decoder private size=%u", (unsigned)sizeof(TRITON_VIDEO_DECODER));
+    return sizeof(TRITON_VIDEO_DECODER);
+}
+static HRESULT APIENTRY videoCreateDecoder(D3D10DDI_HDEVICE h, const D3D11_1DDIARG_CREATEVIDEODECODER *args, D3D11_1DDI_HDECODE object, D3D11_1DDI_HRTDECODE runtime) {
+    PTRITON_DEVICE p = videoDevice(h); D3D11_VIDEO_DECODER_DESC desc; D3D11_VIDEO_DECODER_CONFIG config;
+    if (!p || !p->pVideoDev || !args || !object.pDrvPrivate) return E_INVALIDARG;
+    npt_log("video: create decoder callback %ux%u raw=%u min-targets=%u", args->Desc.SampleWidth, args->Desc.SampleHeight, args->Config.ConfigBitstreamRaw, args->Config.ConfigMinRenderTargetBuffCount);
+    TRITON_VIDEO_DECODER *out = object.pDrvPrivate; out->object = NULL;
+    memcpy(&desc, &args->Desc, sizeof(desc)); memcpy(&config, &args->Config, sizeof(config));
+    HRESULT hr = ID3D11VideoDevice_CreateVideoDecoder(p->pVideoDev, &desc, &config, &out->object);
+    npt_log("video: native decoder create hr=%08x object=%s", (unsigned)hr, out->object ? "yes" : "no");
+    if (SUCCEEDED(hr)) {
+        hr = videoCommand(p, out->object, PERP_VIDEO_RESOURCE_QUERY, NULL, 0, NULL, 0);
+        npt_log("video: resource query hr=%08x", (unsigned)hr);
+    }
+    if (FAILED(hr) && out->object) { ID3D11VideoDecoder_Release(out->object); out->object = NULL; }
+    return hr;
+}
+static VOID APIENTRY videoDestroyDecoder(D3D10DDI_HDEVICE h, D3D11_1DDI_HDECODE object) {
+    TRITON_VIDEO_DECODER *p = object.pDrvPrivate; if (p && p->object) { ID3D11VideoDecoder_Release(p->object); p->object = NULL; }
+}
+static SIZE_T APIENTRY videoOutputSize(D3D10DDI_HDEVICE h, const D3D11_1DDIARG_CREATEVIDEODECODEROUTPUTVIEW *args) { return sizeof(TRITON_VIDEO_OUTPUT); }
+static HRESULT APIENTRY videoCreateOutput(D3D10DDI_HDEVICE h, const D3D11_1DDIARG_CREATEVIDEODECODEROUTPUTVIEW *args, D3D11_1DDI_HVIDEODECODEROUTPUTVIEW object, D3D11_1DDI_HRTVIDEODECODEROUTPUTVIEW runtime) {
+    PTRITON_DEVICE p = videoDevice(h); if (!object.pDrvPrivate) return E_INVALIDARG;
+    TRITON_VIDEO_OUTPUT *out = object.pDrvPrivate; out->object = NULL;
+    if (!p || !p->pVideoDev || !args || !args->hDrvResource.pDrvPrivate || args->MipSlice || args->ArraySize != 1) return E_INVALIDARG;
+    PTRITON_RESOURCE r = args->hDrvResource.pDrvPrivate;
+    if (!r->pResource || r->Format != DXGI_FORMAT_NV12 || args->FirstArraySlice >= r->ArraySize) return E_INVALIDARG;
+    D3D11_VIDEO_DECODER_OUTPUT_VIEW_DESC desc = {0}; desc.DecodeProfile = args->DecodeProfile;
+    desc.ViewDimension = D3D11_VDOV_DIMENSION_TEXTURE2D; desc.Texture2D.ArraySlice = args->FirstArraySlice;
+    return ID3D11VideoDevice_CreateVideoDecoderOutputView(p->pVideoDev, r->pResource, &desc, &out->object);
+}
+static VOID APIENTRY videoDestroyOutput(D3D10DDI_HDEVICE h, D3D11_1DDI_HVIDEODECODEROUTPUTVIEW object) {
+    TRITON_VIDEO_OUTPUT *p = object.pDrvPrivate; if (p && p->object) { ID3D11VideoDecoderOutputView_Release(p->object); p->object = NULL; }
+}
+static HRESULT APIENTRY videoBegin(D3D10DDI_HDEVICE h, D3D11_1DDI_HDECODE object, const D3D11_1DDIARG_VIDEODECODERBEGINFRAME *args) {
+    PTRITON_DEVICE p = videoDevice(h); ID3D11VideoDecoder *decoder = videoDecoder(object);
+    if (!p || !p->pVideoCtx || !decoder || !args || args->pContentKey || args->ContentKeySize || !args->hOutputView.pDrvPrivate) return E_INVALIDARG;
+    TRITON_VIDEO_OUTPUT *out = args->hOutputView.pDrvPrivate; if (!out->object) return E_INVALIDARG;
+    return ID3D11VideoContext_DecoderBeginFrame(p->pVideoCtx, decoder, out->object, 0, NULL);
+}
+static VOID APIENTRY videoEnd(D3D10DDI_HDEVICE h, D3D11_1DDI_HDECODE object) {
+    PTRITON_DEVICE p = videoDevice(h);
+    HRESULT hr = videoCommand(p, videoDecoder(object), PERP_VIDEO_RESOURCE_FINISH, NULL, 0, NULL, 0);
+    if (FAILED(hr) && p) tritonSetError(p, hr);
+}
+static BOOL videoBufferType(D3D11_1DDI_VIDEO_DECODER_BUFFER_TYPE type, UINT *out) {
+    switch (type) {
+    case D3D11_1DDI_VIDEO_DECODER_BUFFER_PICTURE_PARAMETERS: *out = D3D11_VIDEO_DECODER_BUFFER_PICTURE_PARAMETERS; return TRUE;
+    case D3D11_1DDI_VIDEO_DECODER_BUFFER_SLICE_CONTROL: *out = D3D11_VIDEO_DECODER_BUFFER_SLICE_CONTROL; return TRUE;
+    case D3D11_1DDI_VIDEO_DECODER_BUFFER_BITSTREAM: *out = D3D11_VIDEO_DECODER_BUFFER_BITSTREAM; return TRUE;
+    default: return FALSE;
+    }
+}
+static HRESULT videoSubmit(PTRITON_DEVICE p, ID3D11VideoDecoder *decoder, UINT count, const D3D11_1DDI_VIDEO_DECODER_BUFFER_DESC *buffers) {
+    struct { struct perp_video_resource_header header; struct perp_video_resource_buffer entries[PERP_VIDEO_MAX_BUFFERS]; } packet = {0};
+    ID3D11Resource *resources[PERP_VIDEO_MAX_BUFFERS] = {0};
+    if (!p || !decoder || !buffers || !count || count > PERP_VIDEO_MAX_BUFFERS) return E_INVALIDARG;
+    packet.header.version = PERP_VIDEO_RESOURCE_VERSION; packet.header.count = count;
+    for (UINT i = 0; i < count; i++) {
+        const D3D11_1DDI_VIDEO_DECODER_BUFFER_DESC *b = &buffers[i];
+        PTRITON_RESOURCE r = b->hResource.pDrvPrivate;
+        if (!r || !r->pResource || b->pIV || b->IVSize || b->PartialEncryption || !videoBufferType(b->BufferType, &packet.entries[i].type)) return E_INVALIDARG;
+        packet.entries[i].resource_index = i; packet.entries[i].offset = b->DataOffset; packet.entries[i].size = b->DataSize;
+        resources[i] = r->pResource;
+    }
+    return videoCommand(p, decoder, PERP_VIDEO_RESOURCE_SUBMIT, &packet,
+        sizeof(packet.header) + count * sizeof(packet.entries[0]), resources, count);
+}
+static HRESULT APIENTRY videoSubmitBuffers(D3D10DDI_HDEVICE h, D3D11_1DDI_HDECODE d, UINT count, const D3D11_1DDI_VIDEO_DECODER_BUFFER_DESC *buffers) {
+    return videoSubmit(videoDevice(h), videoDecoder(d), count, buffers);
+}
+static HRESULT APIENTRY videoSubmitBuffers1(D3D10DDI_HDEVICE h, D3D11_1DDI_HDECODE d, UINT count, const D3DWDDM2_0DDI_VIDEO_DECODER_BUFFER_DESC1 *buffers) {
+    D3D11_1DDI_VIDEO_DECODER_BUFFER_DESC legacy[PERP_VIDEO_MAX_BUFFERS] = {0};
+    if (!buffers || !count || count > PERP_VIDEO_MAX_BUFFERS) return E_INVALIDARG;
+    for (UINT i = 0; i < count; i++) {
+        if (buffers[i].pIV || buffers[i].IVSize || buffers[i].pSubSampleMappingBlock || buffers[i].SubSampleMappingCount) return E_INVALIDARG;
+        legacy[i].hResource = buffers[i].hResource; legacy[i].BufferType = buffers[i].BufferType;
+        legacy[i].DataOffset = buffers[i].DataOffset; legacy[i].DataSize = buffers[i].DataSize;
+    }
+    return videoSubmit(videoDevice(h), videoDecoder(d), count, legacy);
+}
+static VOID APIENTRY videoCapabilities(D3D10DDI_HDEVICE h, D3DWDDM2_0DDI_VIDEO_CAPABILITY_QUERY type, UINT size, VOID *data) {
+    if (!data) return;
+    if (type == D3DWDDM2_0DDI_VIDEO_CAPABILITY_QUERY_DECODER_CAPS && size == sizeof(D3DWDDM2_0DDI_VIDEO_CAPABILITY_DECODER_CAPS)) {
+        D3DWDDM2_0DDI_VIDEO_CAPABILITY_DECODER_CAPS *caps = data;
+        D3D11_1DDI_VIDEO_DECODER_DESC desc = {caps->DecodeProfile, caps->SampleWidth, caps->SampleHeight, DXGI_FORMAT_NV12};
+        caps->Caps = !caps->pCryptoType && videoDesc(videoDevice(h), &desc) ? 0 : D3DWDDM2_0DDI_VIDEO_DECODER_CAP_UNSUPPORTED;
+    } else if (type == D3DWDDM2_0DDI_VIDEO_CAPABILITY_QUERY_DECODER_DOWNSAMPLING && size == sizeof(D3DWDDM2_0DDI_VIDEO_CAPABILITY_DECODER_DOWNSAMPLING)) {
+        D3DWDDM2_0DDI_VIDEO_CAPABILITY_DECODER_DOWNSAMPLING *caps = data; caps->Supported = caps->RealTime = FALSE;
+    } else if (type == D3DWDDM2_0DDI_VIDEO_CAPABILITY_QUERY_DECODER_DOWNSAMPLE_OUTPUT_FORMAT && size == sizeof(D3DWDDM2_0DDI_VIDEO_CAPABILITY_DECODER_DOWNSAMPLE_OUTPUT_FORMAT)) {
+        ((D3DWDDM2_0DDI_VIDEO_CAPABILITY_DECODER_DOWNSAMPLE_OUTPUT_FORMAT *)data)->Supported = FALSE;
+    }
+}
