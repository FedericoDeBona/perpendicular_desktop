const module=Process.getModuleByName('libdxmt-native.dylib');const syms=module.enumerateSymbols();
const base='_ZN4dxmt29MTLD3D11DeviceContextImplBaseINS_20ContextInternalStateEE';
function symbol(method){const rows=syms.filter(s=>s.name.startsWith(base+method.length+method+'E'));if(rows.length!==1)throw Error(method+': '+rows.length);return rows[0].address;}
const timebase=Memory.alloc(8);new NativeFunction(Module.getGlobalExportByName('mach_timebase_info'),'int',['pointer'])(timebase);const num=timebase.readU32(),den=timebase.add(4).readU32();if(!num||!den)throw Error('Timebase unavailable');
const store=Memory.alloc(48*2048),counters=Memory.alloc(40),limits=Memory.alloc(8);counters.writeByteArray(new Uint8Array(40));limits.writeU64(Math.floor(16000000*den/num));
const cm=new CModule(C_SOURCE,{store,counters,limits,ticks:Module.getGlobalExportByName('mach_absolute_time'),get_srv:symbol('PSGetShaderResources'),get_ps:symbol('PSGetShader'),get_vb:symbol('IAGetVertexBuffers'),get_ib:symbol('IAGetIndexBuffer'),get_rt:symbol('OMGetRenderTargets')});
const rowSize=new NativeFunction(cm.row_size,'uint',[])();if(rowSize>2048||rowSize<1000)throw Error('Row ABI '+rowSize);
const hooks=[['DrawIndexed','draw_indexed'],['Draw','draw'],['DrawIndexedInstanced','indexed_instanced'],['DrawInstanced','instanced']].map(([method,cb])=>Interceptor.attach(symbol(method),{onEnter:cm[cb]}));
let stopped=false;
function status(){return {records:counters.add(4).readU32(),total:counters.readU32(),errors:counters.add(8).readU32(),stopped:stopped||counters.add(12).readU32()!==0,measuredCallbacks:counters.add(16).readU32(),filteredCallbacks:counters.add(20).readU32(),totalMilliseconds:Number(counters.add(24).readU64())*num/den/1000000,maxMilliseconds:Number(counters.add(32).readU64())*num/den/1000000,rowSize};}
rpc.exports={status,stop(){counters.add(12).writeU32(1);hooks.forEach(h=>h.detach());Interceptor.flush();stopped=true;return status();},dump(){const rows=[];for(let i=0;i<counters.add(4).readU32();i++){const p=store.add(i*rowSize);const triangles=p.add(64).readU32();rows.push({tick:Number(p.readU64()),context:p.add(8).readPointer(),target:p.add(16).readPointer(),ps:p.add(24).readPointer(),method:p.add(32).readU32(),count:p.add(36).readU32(),start:p.add(40).readU32(),base:p.add(44).readS32(),width:p.add(48).readU32(),height:p.add(52).readU32(),stride:p.add(56).readU32(),indexFormat:p.add(60).readU32(),triangles,truncated:p.add(68).readU32(),srvs:Array.from({length:4},(_,j)=>Array.from(new Uint32Array(p.add(72+j*24).readByteArray(24)))),bounds:Array.from(new Float32Array(p.add(168).readByteArray(Math.min(64,triangles)*16)))});}return rows;}};
send({kind:'ready',pid:Process.id,rowSize});
