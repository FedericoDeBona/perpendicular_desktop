--- a/src/virtio/neptune/npt_resource.c
+++ b/src/virtio/neptune/npt_resource.c
@@ -360,8 +360,18 @@
       return next;
 
    /* Grow path: bring up a fresh slot at active_count. */
-   if (cnt < r->max_slots && alloc_slot_locked(r, cnt))
-      return cnt;
+   if (cnt < r->max_slots) {
+      if (alloc_slot_locked(r, cnt))
+         return cnt;
+#if defined(_WIN32)
+      /* RES_INFO can refuse another CPU window under pressure.  The
+       * existing slots are usable: keep their fence-backed wait path,
+       * and stop retrying the same optional growth on every DISCARD.
+       * This resource retains its successful depth until destruction. */
+      r->max_slots = cnt;
+      NPT_ALLOC_TRACE("map growth capped", r->aligned_slot_size, 0, cnt);
+#endif
+   }
 
    /* At cap (or grow failed): the first slot no open Map holds, waiting
     * for the host there. */
