+npt_d3d11_buffer_preserve_initial_data(struct npt_d3d11_buffer *b,
+                                        const void *data)
+{
+   struct npt_d3d11_buffer_aux *aux = buf_aux(b);
+   if (!aux || !aux->has_desc) return false;
+   if (!data || aux->desc.Usage != D3D11_USAGE_DYNAMIC ||
+       !(aux->desc.CPUAccessFlags & D3D11_CPU_ACCESS_WRITE))
+      return true;
+   void *copy = malloc(aux->byte_width);
+   if (!copy) return false;
+   memcpy(copy, data, aux->byte_width);
+   /* CreateBuffer has not published this wrapper to its caller yet. */
+   atomic_store_explicit(&aux->initial_data, copy, memory_order_release);
+   return true;
+}
