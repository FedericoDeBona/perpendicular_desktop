+  HRESULT copyCPUVideoInput(UINT offset, UINT size, void *destination) override {
+    // Only a dynamic upload with no GPU-output binding is CPU-only. A dynamic buffer
+    // may legally receive GPU copies, so its first such write permanently
+    // disables this path, even after a later DISCARD/rename.
