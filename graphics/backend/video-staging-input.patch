+  HRESULT CopyCPUVideoInput(ID3D11Buffer *source, UINT offset, UINT size, void *destination) {
+    std::lock_guard<d3d11_device_mutex> lock(mutex);
+    if (!source || !destination || !size) return E_INVALIDARG;
+    D3D11_BUFFER_DESC desc = {};
+    source->GetDesc(&desc);
+    if (desc.Usage == D3D11_USAGE_DYNAMIC) {
+      HRESULT hr = GetResourceCommon(source)->copyCPUVideoInput(offset, size, destination);
+      static std::atomic<unsigned> dynamic_samples{0};
+      if (dynamic_samples.fetch_add(1, std::memory_order_relaxed) < 8)
+        std::fprintf(stderr, "Perpendicular video dynamic snapshot: capacity=%u offset=%u bytes=%u hr=0x%x\n",
+                     desc.ByteWidth, offset, size, unsigned(hr));
+      return hr;
+    }
+    if (desc.Usage != D3D11_USAGE_STAGING) return S_FALSE;
+    auto staging = GetStagingResource(source, 0);
+    if (!staging || offset > staging->length || size > staging->length - offset)
+      return E_INVALIDARG;
+    // Read the current CPU allocation only after all writes to it complete.
+    // CPU-only uploads have no GPU write dependency. A prior GPU copy still
+    // requires the same queue fence as Map(READ), without adding another blit.
+    bool waited = false;
+    for (;;) {
+      auto coherent = cmd_queue.CoherentSeqId();
+      auto result = staging->tryMap(coherent, true, false);
+      if (result == StagingMapResult::Mapped || result == StagingMapResult::Renamable)
+        return E_FAIL;
+      if (result == StagingMapResult::Mappable) break;
+      Flush();
+      cmd_queue.WaitCPUFence(coherent + uint64_t(result));
+      waited = true;
+    }
+    auto bytes = static_cast<const uint8_t *>(staging->mappedImmediateMemory());
+    if (!bytes) return E_FAIL;
+    std::memcpy(destination, bytes + offset, size);
+    static std::atomic<unsigned> samples{0};
+    if (samples.fetch_add(1, std::memory_order_relaxed) < 8)
+      std::fprintf(stderr, "Perpendicular video input snapshot: capacity=%u offset=%u bytes=%u cpu=0x%x waited=%u\n",
+                   desc.ByteWidth, offset, size, desc.CPUAccessFlags, unsigned(waited));
