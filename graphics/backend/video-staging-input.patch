+      std::fprintf(stderr, "Perpendicular video CPU eligibility: usage=%u bind=0x%x misc=0x%x cpu=0x%x allocation=%u gpuWritten=%u\n",
+                   unsigned(desc.Usage), desc.BindFlags, desc.MiscFlags, desc.CPUAccessFlags,
+                   unsigned(dynamic_.ptr() != nullptr), unsigned(gpu_written));
+    if (desc.Usage != D3D11_USAGE_DYNAMIC || desc.CPUAccessFlags != D3D11_CPU_ACCESS_WRITE ||
