+/* Eight informational Map records, independently bounded from faults.
+ * Cookie names accepted host-shared storage, not an address or byte counter. */
+static inline void tritonTraceVideoInput(UINT bytes, UINT cookie) {
+    static volatile LONG emitted;
+    if (InterlockedIncrement(&emitted) > 8) return;
+    static const GUID provider = {0x48dce1b6,0xe965,0x4e8a,{0xb5,0xfa,0xd9,0xcb,0x52,0x65,0x72,0x12}};
+    REGHANDLE handle = 0;
+    if (EventRegister(&provider, NULL, NULL, &handle) != ERROR_SUCCESS) return;
+    WCHAR message[256];
+    _snwprintf_s(message, 256, _TRUNCATE,
+        L"Perpendicular video input v16: capacity=%u external_cookie=%u", bytes, cookie);
+    EventWriteString(handle, 4, 1, message);
+    EventUnregister(handle);
+}
+
 #endif
