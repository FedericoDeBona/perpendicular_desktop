-    ID3D11PixelShader *ps = (s && s->u.pPS) ? s->u.pPS : NULL;
-    ID3D11DeviceContext1_PSSetShader(pD->pCtx1, ps, NULL, 0);
+    pD->pCurrentPS = s;
+    /* Always sent: the DXGI blit binds its own PS on the context and has the
