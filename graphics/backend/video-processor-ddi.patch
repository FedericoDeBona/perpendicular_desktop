+/* Flip-model rotation replaces TRITON_RESOURCE.pResource without replacing
+ * the runtime view handle. Keep the descriptor and refresh against that exact
+ * resource before use, retaining references on both sides of the transition. */
+static HRESULT processorRefreshInput(TRITON_PROCESSOR_INPUT *v) {
+    ID3D11Resource *resource = v->resource ? v->resource->pResource : NULL;
+    if (!resource) return E_INVALIDARG;
+    if (resource == v->boundResource) return S_OK;
+    ID3D11VideoProcessorInputView *next = NULL;
+    HRESULT hr = processorSyncInput(v->owner, resource, v->enumerator, &v->desc, &next);
+    if (FAILED(hr)) return hr;
+    ID3D11Resource_AddRef(resource); ID3D11VideoProcessorInputView_Release(v->object);
+    ID3D11Resource_Release(v->boundResource); v->object = next; v->boundResource = resource; return S_OK;
+}
+static HRESULT processorRefreshOutput(TRITON_PROCESSOR_OUTPUT *v) {
+    ID3D11Resource *resource = v->resource ? v->resource->pResource : NULL;
+    if (!resource) return E_INVALIDARG;
+    if (resource == v->boundResource) return S_OK;
+    ID3D11VideoProcessorOutputView *next = NULL;
+    HRESULT hr = processorSyncOutput(v->owner, resource, v->enumerator, &v->desc, &next);
+    if (FAILED(hr)) return hr;
+    ID3D11Resource_AddRef(resource); ID3D11VideoProcessorOutputView_Release(v->object);
+    ID3D11Resource_Release(v->boundResource); v->object = next; v->boundResource = resource; return S_OK;
+}
+/* Optional failure-only metadata trace in the caller-selected QA file. */
+static void processorTraceFailure(TRITON_PROCESSOR *v) {
+    char path[1024]; static LONG count;
+    DWORD n = GetEnvironmentVariableA("PERP_VIDEO_TRACE_PATH", path, sizeof(path));
+    if (!n || n >= sizeof(path) || InterlockedIncrement(&count) > 8) return;
+    FILE *file = fopen(path, "a"); if (!file) return;
+    fprintf(file, "pid=%lu blt state outputColor=%u inputColor=%u mirror=%d outputHDR=%d inputHDR=%d colorInvalid=%d/%d\n",
+        GetCurrentProcessId(), v->outputColorTrace, v->inputColorTrace, v->badMirror, v->badOutputHDR, v->badStreamHDR, v->badOutputColor, v->badStreamColor);
+    fclose(file);
+}
+static HRESULT APIENTRY processorBlt(D3D10DDI_HDEVICE h, D3D11_1DDI_HVIDEOPROCESSOR object,
+    D3D11_1DDI_HVIDEOPROCESSOROUTPUTVIEW output, UINT frame, UINT count, const D3D11_1DDI_VIDEO_PROCESSOR_STREAM *streams) {
+    PTRITON_DEVICE p = videoDevice(h); TRITON_PROCESSOR *v = processorState(p, object); TRITON_PROCESSOR_OUTPUT *out = output.pDrvPrivate;
+    if (!p || !p->pVideoCtx || !v || !out || out->owner != p || !out->object || count != 1 || !streams) return E_INVALIDARG;
+    if (v->badOutputColor || v->badStreamColor || v->badMirror || v->badOutputHDR || v->badStreamHDR) { processorTraceFailure(v); return E_NOTIMPL; }
+    const D3D11_1DDI_VIDEO_PROCESSOR_STREAM *s = streams;
+    if (s->PastFrames || s->FutureFrames || s->hInputSurfaceRight.pDrvPrivate || s->pPastSurfaces || s->pFutureSurfaces || s->pPastSurfacesRight || s->pFutureSurfacesRight) return E_NOTIMPL;
+    TRITON_PROCESSOR_INPUT *input = s->hInputSurface.pDrvPrivate;
+    if (s->Enable && (!input || input->owner != p || !input->object)) return E_INVALIDARG;
+    HRESULT hr = processorRefreshOutput(out); if (FAILED(hr)) return hr;
+    if (s->Enable) { hr = processorRefreshInput(input); if (FAILED(hr)) return hr; }
+    return tritonVideoSyncBlt(p->pVideoCtx, v->object, out->object, frame,
+        s->Enable, s->OutputIndex, s->InputFrameOrField, s->Enable ? input->object : NULL);
+}
