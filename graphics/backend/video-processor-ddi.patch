+/* Copyright 2026 Turing Software LLC
+ * SPDX-License-Identifier: MIT */
+#include "tritonVideoProtocol.h"
+#include "npt_com.h"
+#include "neptune-protocol/npt_protocol_guest_id3d11videodevice.h"
+#include "neptune-protocol/npt_protocol_guest_id3d11videocontext.h"
+
+/* The generic proxy creates/Blt use deferred-fatal async semantics. The DDI
+ * requires recoverable HRESULTs: reuse existing reply-bearing wire operations
+ * and normal COM wrapping, without changing protocol ABI or global defaults. */
+static HRESULT processorWrap(void *device, HRESULT hr, void *raw, const GUID *iid, void **out) {
+    *out = NULL;
+    if (FAILED(hr) || !raw) return FAILED(hr) ? hr : E_FAIL;
+    *out = npt_com_get_or_wrap_or_release(npt_com_self_device(device), iid,
+        (uint64_t)(uintptr_t)raw, (struct npt_com_base *)device);
+    return *out ? hr : E_OUTOFMEMORY;
+}
+int32_t tritonVideoSyncEnum(void *device, const TRITON_VIDEO_CONTENT *d, void **out) {
+    D3D11_VIDEO_PROCESSOR_CONTENT_DESC desc = {0};
+    desc.InputFrameFormat = (D3D11_VIDEO_FRAME_FORMAT)d->inputFormat;
+    desc.InputFrameRate.Numerator = d->inputNumerator; desc.InputFrameRate.Denominator = d->inputDenominator;
+    desc.InputWidth = d->inputWidth; desc.InputHeight = d->inputHeight;
+    desc.OutputFrameRate.Numerator = d->outputNumerator; desc.OutputFrameRate.Denominator = d->outputDenominator;
+    desc.OutputWidth = d->outputWidth; desc.OutputHeight = d->outputHeight; desc.Usage = (D3D11_VIDEO_USAGE)d->usage;
+    ID3D11VideoProcessorEnumerator *raw = NULL;
+    HRESULT hr = npt_call_ID3D11VideoDevice_CreateVideoProcessorEnumerator(
+        npt_com_self_ring(device), npt_com_self_id(device), &desc, &raw);
+    return processorWrap(device, hr, raw, &NPT_IID_ID3D11VideoProcessorEnumerator, out);
+}
+int32_t tritonVideoSyncCreate(void *device, void *enumerator, uint32_t index, void **out) {
+    ID3D11VideoProcessor *raw = NULL;
+    HRESULT hr = npt_call_ID3D11VideoDevice_CreateVideoProcessor(
+        npt_com_self_ring(device), npt_com_self_id(device), enumerator, index, &raw);
+    return processorWrap(device, hr, raw, &NPT_IID_ID3D11VideoProcessor, out);
+}
+int32_t tritonVideoSyncInput(void *device, void *resource, void *enumerator,
+    uint32_t fourcc, uint32_t mip, uint32_t slice, void **out) {
+    D3D11_VIDEO_PROCESSOR_INPUT_VIEW_DESC desc = {0};
+    desc.FourCC = fourcc; desc.ViewDimension = D3D11_VPIV_DIMENSION_TEXTURE2D;
+    desc.Texture2D.MipSlice = mip; desc.Texture2D.ArraySlice = slice;
+    ID3D11VideoProcessorInputView *raw = NULL;
+    HRESULT hr = npt_call_ID3D11VideoDevice_CreateVideoProcessorInputView(
+        npt_com_self_ring(device), npt_com_self_id(device), resource, enumerator, &desc, &raw);
+    return processorWrap(device, hr, raw, &NPT_IID_ID3D11VideoProcessorInputView, out);
+}
+int32_t tritonVideoSyncOutput(void *device, void *resource, void *enumerator,
+    uint32_t array, uint32_t mip, uint32_t slice, uint32_t count, void **out) {
+    D3D11_VIDEO_PROCESSOR_OUTPUT_VIEW_DESC desc = {0};
+    if (array) {
+        desc.ViewDimension = D3D11_VPOV_DIMENSION_TEXTURE2DARRAY;
+        desc.Texture2DArray.MipSlice = mip; desc.Texture2DArray.FirstArraySlice = slice; desc.Texture2DArray.ArraySize = count;
+    } else { desc.ViewDimension = D3D11_VPOV_DIMENSION_TEXTURE2D; desc.Texture2D.MipSlice = mip; }
+    ID3D11VideoProcessorOutputView *raw = NULL;
+    HRESULT hr = npt_call_ID3D11VideoDevice_CreateVideoProcessorOutputView(
+        npt_com_self_ring(device), npt_com_self_id(device), resource, enumerator, &desc, &raw);
+    return processorWrap(device, hr, raw, &NPT_IID_ID3D11VideoProcessorOutputView, out);
+}
+int32_t tritonVideoSyncBlt(void *context, void *processor, void *output, uint32_t frame,
+    int32_t enable, uint32_t outputIndex, uint32_t inputFrame, void *input) {
+    D3D11_VIDEO_PROCESSOR_STREAM stream = {0};
+    stream.Enable = enable; stream.OutputIndex = outputIndex; stream.InputFrameOrField = inputFrame; stream.pInputSurface = input;
+    return npt_call_ID3D11VideoContext_VideoProcessorBlt(
+        npt_com_self_ring(context), npt_com_self_id(context), processor, output, frame, 1, &stream);
+}
