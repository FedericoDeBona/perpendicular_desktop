+/* The protocol bridge uses reply-bearing normal D3D11 calls so recoverable
+ * host failures reach the runtime rather than becoming deferred fatal errors. */
+static HRESULT processorSyncEnum(PTRITON_DEVICE p, const D3D11_VIDEO_PROCESSOR_CONTENT_DESC *d, ID3D11VideoProcessorEnumerator **out) {
+    TRITON_VIDEO_CONTENT c = { d->InputFrameFormat, d->InputFrameRate.Numerator, d->InputFrameRate.Denominator,
+        d->InputWidth, d->InputHeight, d->OutputFrameRate.Numerator, d->OutputFrameRate.Denominator,
+        d->OutputWidth, d->OutputHeight, d->Usage };
+    void *object = NULL; HRESULT hr = tritonVideoSyncEnum(p->pVideoDev, &c, &object); *out = object; return hr;
+}
+static HRESULT processorSyncCreate(PTRITON_DEVICE p, ID3D11VideoProcessorEnumerator *e, UINT index, ID3D11VideoProcessor **out) {
+    void *object = NULL; HRESULT hr = tritonVideoSyncCreate(p->pVideoDev, e, index, &object); *out = object; return hr;
+}
+static HRESULT processorSyncInput(PTRITON_DEVICE p, ID3D11Resource *r, ID3D11VideoProcessorEnumerator *e, const D3D11_VIDEO_PROCESSOR_INPUT_VIEW_DESC *d, ID3D11VideoProcessorInputView **out) {
+    void *object = NULL; HRESULT hr = tritonVideoSyncInput(p->pVideoDev, r, e, d->FourCC, d->Texture2D.MipSlice, d->Texture2D.ArraySlice, &object); *out = object; return hr;
+}
+static HRESULT processorSyncOutput(PTRITON_DEVICE p, ID3D11Resource *r, ID3D11VideoProcessorEnumerator *e, const D3D11_VIDEO_PROCESSOR_OUTPUT_VIEW_DESC *d, ID3D11VideoProcessorOutputView **out) {
+    BOOL array = d->ViewDimension == D3D11_VPOV_DIMENSION_TEXTURE2DARRAY;
+    void *object = NULL; HRESULT hr = tritonVideoSyncOutput(p->pVideoDev, r, e, array,
+        array ? d->Texture2DArray.MipSlice : d->Texture2D.MipSlice,
+        array ? d->Texture2DArray.FirstArraySlice : 0, array ? d->Texture2DArray.ArraySize : 1, &object); *out = object; return hr;
+}
