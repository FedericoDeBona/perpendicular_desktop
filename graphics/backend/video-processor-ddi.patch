+    D3D11_1DDI_HVIDEOPROCESSORINPUTVIEW object, D3D11_1DDI_HRTVIDEOPROCESSORINPUTVIEW runtime) {
+    PTRITON_DEVICE p = videoDevice(h); TRITON_PROCESSOR_INPUT *out = object.pDrvPrivate; if (out) memset(out, 0, sizeof(*out));
+    static unsigned inputTraceCount;
