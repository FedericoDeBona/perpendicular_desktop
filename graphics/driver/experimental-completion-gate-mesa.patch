 void tritonScheduleDestroy(PTRITON_DEVICE p)
 {
     tritonScheduleBridgeDestroy(p->scheduleState);
     p->scheduleState = NULL;
+    if (p->pScheduleFence) ID3D11Fence_Release(p->pScheduleFence);
+    if (p->pScheduleContext) ID3D11DeviceContext4_Release(p->pScheduleContext);
+    p->pScheduleFence = NULL; p->pScheduleContext = NULL;
 }
+
+/* Submit the completion packet only AFTER every start packet needed by
+ * Signal/Flush. Reversing that order would gate the work on its own finish.
+ * The runtime's later monitored Signal shares hKMContext with this packet. */
+BOOL tritonScheduleComplete(PTRITON_DEVICE p)
+{
+    if (!p->scheduleState) return TRUE;
+    EnterCriticalSection(&p->kmCtxLock);
+    UINT64 value = ++p->scheduleFenceValue, token = 0;
+    HRESULT hr = value ? ID3D11DeviceContext4_Signal(p->pScheduleContext, p->pScheduleFence, value) : E_FAIL;
+    if (SUCCEEDED(hr)) {
+        ID3D11DeviceContext1_Flush(p->pCtx1);
+        if (!tritonScheduleBridgeArm(p->pScheduleFence, value, &token)) hr = E_FAIL;
+    }
+    if (SUCCEEDED(hr)) {
+        VIOGPU_DMA_PRIVATE priv = {0};
+        priv.magic = VIOGPU_DMA_PRIV_MAGIC;
+        priv.bodySize = sizeof(VIOGPU_COMMAND_HDR) + sizeof(token);
+        VIOGPU_COMMAND_HDR *hdr = (VIOGPU_COMMAND_HDR *)priv.body;
+        hdr->type = VIOGPU_CMD_GATE; hdr->size = sizeof(token);
+        memcpy(hdr + 1, &token, sizeof(token));
+        D3DDDICB_SUBMITCOMMAND sub = {0};
+        sub.Commands = 0x700000000ull; sub.CommandLength = 64;
+        sub.BroadcastContextCount = 1; sub.BroadcastContext[0] = p->hKMContext;
+        sub.pPrivateDriverData = &priv; sub.PrivateDriverDataSize = sizeof(priv);
+        hr = p->KTCallbacks.pfnSubmitCommandCb(p->hRTDevice.handle, &sub);
+    }
+    LeaveCriticalSection(&p->kmCtxLock);
+    if (value <= 16) {
+        fprintf(stderr, "trial complete: value=%llu token=%llu runtime=%p hr=%08lx\n",
+            (unsigned long long)value, (unsigned long long)token, (void *)p->hKMContext, (unsigned long)hr);
+        fflush(stderr);
+    }
+    if (FAILED(hr)) tritonSetError(p, hr);
+    return SUCCEEDED(hr);
+}
