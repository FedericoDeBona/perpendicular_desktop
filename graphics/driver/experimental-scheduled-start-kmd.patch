+
+// Private trial protocol: a release must never address another process.
+bool VioGpuAdapter::CanScheduleContext(VioGpuDevice *source, UINT target)
+{
+    if (!source || !target) return false;
+    bool found = false;
+    KIRQL irql;
+    KeAcquireSpinLock(&ScheduledDevicesLock, &irql);
+    for (LIST_ENTRY *e = ScheduledDevices.Flink; e != &ScheduledDevices; e = e->Flink) {
+        VioGpuDevice *d = CONTAINING_RECORD(e, VioGpuDevice, ScheduledEntry);
+        if (d->OwnerProcess == source->OwnerProcess && !d->m_Context.IsEmpty() &&
+            d->m_Context.GetCapset() == VIRTIO_GPU_CAPSET_NEPTUNE && d->m_Context.GetId() == target) {
+            found = true; break;
+        }
+    }
+    KeReleaseSpinLock(&ScheduledDevicesLock, irql);
+    return found;
+}
