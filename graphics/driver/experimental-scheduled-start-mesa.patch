@@ -0,0 +1,48 @@
+/* Copyright 2026. SPDX-License-Identifier: MIT */
+#include "triton.h"
+#include "triton_log.h"
+#include "tritonSharedBridge.h"
+
+static bool tritonScheduleSubmit(void *cookie, uint32_t context, uint64_t ring, uint32_t value)
+{
+    PTRITON_DEVICE p = cookie;
+    struct Start { UINT context; UINT value; UINT64 ring; } start = { context, value, ring };
+    VIOGPU_DMA_PRIVATE priv = {0};
+    priv.magic = VIOGPU_DMA_PRIV_MAGIC;
+    priv.bodySize = sizeof(VIOGPU_COMMAND_HDR) + sizeof(start);
+    VIOGPU_COMMAND_HDR *hdr = (VIOGPU_COMMAND_HDR *)priv.body;
+    hdr->type = 0xB; hdr->size = sizeof(start);
+    memcpy(hdr + 1, &start, sizeof(start));
+    D3DDDICB_SUBMITCOMMAND sub = {0};
+    sub.Commands = 0x700000000ull; sub.CommandLength = 64;
+    sub.BroadcastContextCount = 1; sub.BroadcastContext[0] = p->hKMContext;
+    sub.pPrivateDriverData = &priv; sub.PrivateDriverDataSize = sizeof(priv);
+    HRESULT hr = p->KTCallbacks.pfnSubmitCommandCb(p->hRTDevice.handle, &sub);
+    if (value <= 12) {
+        char enabled[2] = {0};
+        if (GetEnvironmentVariableA("PERP_DRIVER_INIT_TRACE", enabled, sizeof(enabled)) == 1 && enabled[0] == '1') {
+            fprintf(stderr, "trial submit: context=%u gate=%llu value=%u runtime=%p hr=%08lx\n", context, (unsigned long long)ring, value, (void *)p->hKMContext, (unsigned long)hr);
+            fflush(stderr);
+        }
+    }
+    return SUCCEEDED(hr);
+}
+
+BOOL tritonScheduleInit(PTRITON_DEVICE p)
+{
+    /* The trial must not change scheduling in DWM or other guest apps. */
+    char enabled[2] = {0};
+    if (GetEnvironmentVariableA("PERP_DRIVER_SCHEDULE_TRIAL", enabled, sizeof(enabled)) != 1 || enabled[0] != '1')
+        return TRUE;
+    triton_trial_stage("schedule init");
+    if (!p->hKMContext || !p->KTCallbacks.pfnSubmitCommandCb) return FALSE;
+    p->scheduleState = tritonScheduleBridgeInit(p->pCtx1, tritonScheduleSubmit, p);
+    TR_LOG("trial schedule: initialization %s", p->scheduleState ? "enabled" : "FAILED");
+    return p->scheduleState != NULL;
+}
+
+void tritonScheduleDestroy(PTRITON_DEVICE p)
+{
+    tritonScheduleBridgeDestroy(p->scheduleState);
+    p->scheduleState = NULL;
+}
