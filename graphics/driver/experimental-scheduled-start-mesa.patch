    return npt_com_get_or_wrap(dev, &NPT_IID_ID3D11Texture2D, mint,
                               (struct npt_com_base *)pDeviceWrapper);
 }
+
+#include "npt_ring.h"
+extern BOOL npt_com_schedule_private_ring(void *self);
+struct triton_schedule_state {
+   struct npt_ring *ring, *gate;
+   mtx_t lock;
+   uint32_t value;
+   bool (*submit)(void *, uint32_t, uint64_t, uint32_t);
+   void *cookie;
+};
+static bool triton_schedule_start(void *cookie, struct npt_ring *ring)
+{
+   struct triton_schedule_state *s = cookie;
+   mtx_lock(&s->lock);
+   bool ok = s->value != UINT32_MAX && s->submit(s->cookie, ring->renderer->info.virtio_ctx_id, s->gate->id, ++s->value);
+   if (ok) npt_ring_schedule_wait(ring, s->gate->id, s->value);
+   mtx_unlock(&s->lock);
+   return ok;
+}
+void *tritonScheduleBridgeInit(void *context, bool (*submit)(void *, uint32_t, uint64_t, uint32_t), void *cookie)
+{
+   if (!npt_com_schedule_private_ring(context)) return NULL;
+   struct npt_device *dev = npt_com_self_device(context);
+   struct triton_schedule_state *s = calloc(1, sizeof(*s));
+   if (!s) return NULL;
+   struct npt_ring_layout layout;
+   npt_ring_get_layout(4096, sizeof(uint32_t), &layout);
+   uint64_t id = atomic_fetch_add(&dev->next_ring_id, 1);
+   s->gate = npt_ring_create(dev, &layout, id, false);
+   if (!s->gate) { free(s); return NULL; }
+   mtx_init(&s->lock, mtx_plain);
+   s->ring = npt_com_object_ring_seqno(context, NULL);
+   s->submit = submit; s->cookie = cookie;
+   s->ring->schedule_cookie = s;
+   s->ring->schedule = triton_schedule_start;
+   return s;
+}
+void tritonScheduleBridgeDestroy(void *state)
+{
+   struct triton_schedule_state *s = state;
+   if (!s) return;
+   s->ring->schedule = NULL;
+   s->ring->schedule_cookie = NULL;
+   npt_ring_wait_seqno(s->ring, npt_ring_seqno_now(s->ring));
+   npt_ring_destroy(s->gate);
+   mtx_destroy(&s->lock);
+   free(s);
+}
