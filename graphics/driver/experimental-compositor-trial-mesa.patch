 #include "triton.h"
 #include "triton_log.h"
 #include "tritonSharedBridge.h"
+#include <wchar.h>
+
+/* DWM is launched by Windows, so it cannot inherit the probe's environment.
+ * Only this isolated-clone marker and the exact compositor image opt in.
+ * Configure before either OpenAdapter probes and caches the Neptune flags.
+ * The marker is read once: changing mode requires a compositor restart. */
+static BOOL CALLBACK tritonTrialConfigureOnce(PINIT_ONCE once, void *parameter, void **context)
+{
+    (void)once; (void)parameter; (void)context;
+    WCHAR image[MAX_PATH];
+    DWORD length = GetModuleFileNameW(NULL, image, MAX_PATH);
+    if (!length || length >= MAX_PATH) return TRUE;
+    WCHAR *name = wcsrchr(image, L'\\');
+    if (!name || _wcsicmp(name + 1, L"dwm.exe")) return TRUE;
+    HANDLE marker = CreateFileW(L"C:\\ProgramData\\PerpendicularDriverTrial\\dwm-mode-9d7d90a7.txt",
+        GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+        NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (marker == INVALID_HANDLE_VALUE) return TRUE;
+    char mode = 0; DWORD count = 0;
+    BOOL read = ReadFile(marker, &mode, 1, &count, NULL);
+    CloseHandle(marker);
+    if (!read || count != 1 || (mode != 'b' && mode != 'f')) return TRUE;
+    FILE *capture = NULL;
+    const char *path = mode == 'f'
+        ? "C:\\ProgramData\\PerpendicularDriverTrial\\dwm-fixed.log"
+        : "C:\\ProgramData\\PerpendicularDriverTrial\\dwm-baseline.log";
+    if (freopen_s(&capture, path, "a", stderr) || !capture) return TRUE;
+    setvbuf(stderr, NULL, _IONBF, 0);
+    SetEnvironmentVariableA("PERP_DRIVER_INIT_TRACE", "1");
+    SetEnvironmentVariableA("NPT_PERF", "multi_ring");
+    SetEnvironmentVariableA("PERP_DRIVER_SCHEDULE_TRIAL", mode == 'f' ? "1" : "0");
+    fprintf(stderr, "trial compositor: pid=%lu mode=%c multi_ring=1\n", GetCurrentProcessId(), mode);
+    return TRUE;
+}
+void tritonTrialConfigureProcess(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce(&once, tritonTrialConfigureOnce, NULL, NULL);
+}

