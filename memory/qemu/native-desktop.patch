+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef PERP_HVF_STP_PCI_HOLE_H
+#define PERP_HVF_STP_PCI_HOLE_H
+#include "exec/ioport.h"
+#include "exec/cpu-common.h"
+#include "exec/memory.h"
+#include "exec/target_page.h"
+#include "decode.h"
+
+/* Debug translation is for instruction observation only. Intermediate page
+ * table reads may dispatch MMIO, as in the separate observation diagnostic. */
+static bool perp_stp_q_code(CPUState *cpu, uint32_t *word)
+{
+    CPUARMState *env = &ARM_CPU(cpu)->env;
+    MemTxAttrs attrs = MEMTXATTRS_UNSPECIFIED;
+    hwaddr page, offset;
+    AddressSpace *as;
+    MemoryRegionSection section;
+    MemoryRegion *mr;
+    uint8_t code[4];
+    int index;
+    bool ok = false;
+    if (env->pc & 3) {
+        return false;
+    }
+    page = cpu_get_phys_page_attrs_debug(cpu, env->pc & TARGET_PAGE_MASK, &attrs);
+    offset = env->pc & ~TARGET_PAGE_MASK;
+    if (page == (hwaddr)-1 || page > UINT64_MAX - offset) {
+        return false;
+    }
+    index = cpu_asidx_from_attrs(cpu, attrs);
+    if (index < 0 || index >= cpu->num_ases) {
+        return false;
+    }
+    as = cpu_get_address_space(cpu, index);
+    if (!as || !as->root) {
+        return false;
+    }
+    section = memory_region_find(as->root, page + offset, 4);
+    mr = section.mr;
+    if (mr && memory_region_is_ram(mr) && !memory_region_is_ram_device(mr) &&
+        !mr->rom_device && mr->ram_block &&
+        int128_ge(section.size, int128_make64(4))) {
+        /* Hotadded RAM may contain executable guest pages. Never fault in
+         * an unplugged block merely to decode the faulting instruction. */
+        RamDiscardManager *rdm = memory_region_get_ram_discard_manager(mr);
+        MemoryRegionSection instruction = section;
+        instruction.size = int128_make64(4);
+        if (rdm && !ram_discard_manager_is_populated(rdm, &instruction)) {
+            memory_region_unref(mr);
+            return false;
+        }
+        const uint8_t *backing = memory_region_get_ram_ptr(mr);
+        if (backing) {
+            memcpy(code, backing + section.offset_within_region, 4);
+            *word = ldl_le_p(code);
+            ok = true;
+        }
+    }
+    if (mr) {
+        memory_region_unref(mr);
+    }
+    return ok;
+}
+
+static bool perp_hvf_stp_pair_pci_hole(CPUState *cpu, uint64_t syndrome,
+                                     uint64_t va, uint64_t pa, bool single)
+{
+    const char *option = getenv(single ? "PERP_HVF_STP_S_PCI_HOLE" :
+                                       "PERP_HVF_STP_Q_PCI_HOLE");
+    CPUARMState *env;
+    MemoryRegionSection section;
+    MemoryRegion *mr;
+    hv_simd_fp_uchar16_t first, second;
+    uint8_t bytes[32];
+    uint32_t word;
+    uint64_t effective_address;
+    int64_t offset;
+    unsigned rt, rt2, rn;
+    MemTxResult result;
+    unsigned element_bytes = single ? 4 : 16;
+    unsigned length = element_bytes * 2;
+    static unsigned logged[2];
+    bool hole;
+
+    if (!option || strcmp(option, "1") || !bql_locked() ||
+        !perp_store_hole_fault(syndrome, va, pa, length) ||
+        !cpu || !cpu->cpu_ases || cpu->num_ases <= 0) {
+        return false;
+    }
+    cpu_synchronize_state(cpu);
+    env = &ARM_CPU(cpu)->env;
+    if (!env->aarch64 || arm_current_el(env) != 0 ||
+        arm_cpu_data_is_big_endian(env) ||
+        ((arm_sctlr(env, 0) & SCTLR_A) && (va & (element_bytes - 1))) ||
+        !perp_stp_q_code(cpu, &word) ||
+        !(single ? perp_stp_s_decode(word, &rt, &rt2, &rn, &offset) :
+                   perp_stp_q_decode(word, &rt, &rt2, &rn, &offset)) ||
+        !(single ? perp_stp_s_address(env->xregs[rn], offset, &effective_address) :
+                   perp_stp_q_address(env->xregs[rn], offset, &effective_address)) ||
+        effective_address != va) {
+        return false;
+    }
+    /* The hardware FAR must equal checked Xn + scaled signed imm7; Xn is never
+     * written back. The fault supplies the first operand's VA/IPA. The complete
+     * access must stay in one minimum 4K page; no debugger operand translation
+     * or assumption across stage1/stage2 page boundaries is used. */
+    section = memory_region_find(address_space_memory.root, pa, length);
+    mr = section.mr;
+    hole = mr && mr->ops == &unassigned_io_ops &&
+           !strcmp(memory_region_name(mr), "gpex_mmio_window") &&
+           !memory_region_is_ram(mr) && !mr->rom_device &&
+           int128_ge(section.size, int128_make64(length));
+    if (!hole) {
+        if (mr) {
+            memory_region_unref(mr);
+        }
+        return false;
+    }
+    if (hv_vcpu_get_simd_fp_reg(cpu->accel->fd, HV_SIMD_FP_REG_Q0 + rt,
+                               &first) != HV_SUCCESS ||
+        hv_vcpu_get_simd_fp_reg(cpu->accel->fd, HV_SIMD_FP_REG_Q0 + rt2,
+                               &second) != HV_SUCCESS) {
+        memory_region_unref(mr);
+        return false;
+    }
+    memcpy(bytes, &first, element_bytes);
+    memcpy(bytes + element_bytes, &second, element_bytes);
+    /* Dispatch exactly the pair width using scalar ISV bus semantics.
+     * The referenced FlatView overlap is entirely the GPEX unassigned handler,
+     * whose write callback ignores writes. No GPU mapping is kept or invented. */
+    result = address_space_write(&address_space_memory, pa,
+                                 MEMTXATTRS_UNSPECIFIED, bytes, length);
+    memory_region_unref(mr);
+    if (result != MEMTX_OK) {
+        return false;
+    }
+    if (logged[single]++ < 64) {
+        error_report("%s emulated=1 bytes=%u", single ?
+                     "perpendicular-hvf-stp-s-hole-v1" :
+                     "perpendicular-hvf-stp-hole-v1", length);
+    }
+    return true;
+}
+
+static bool perp_hvf_stp_q_pci_hole(CPUState *cpu, uint64_t syndrome,
+                                   uint64_t va, uint64_t pa)
+{
+    return perp_hvf_stp_pair_pci_hole(cpu, syndrome, va, pa, false);
+}
+
+static bool perp_hvf_stp_s_pci_hole(CPUState *cpu, uint64_t syndrome,
+                                   uint64_t va, uint64_t pa)
+{
+    return perp_hvf_stp_pair_pci_hole(cpu, syndrome, va, pa, true);
+}
+
+/* Separate default-off admission for the one observed halfword post-index
+ * store. Original STP scope and all unknown-instruction assertions remain. */
+static bool perp_hvf_strh_post2_pci_hole(CPUState *cpu, uint64_t syndrome,
+                                        uint64_t va, uint64_t pa)
+{
+    const char *option = getenv("PERP_HVF_STRH_POST_PCI_HOLE");
+    CPUARMState *env;
+    MemoryRegionSection section;
+    MemoryRegion *mr;
+    uint32_t word;
+    unsigned rt, rn;
+    uint8_t bytes[2];
+    MemTxResult result;
+    static unsigned logged;
+    bool hole;
+
+    if (!option || strcmp(option, "1") || !bql_locked() ||
+        !perp_store_hole_fault(syndrome, va, pa, sizeof(bytes)) ||
+        !cpu || !cpu->cpu_ases || cpu->num_ases <= 0) {
+        return false;
+    }
+    cpu_synchronize_state(cpu);
+    env = &ARM_CPU(cpu)->env;
+    if (!env->aarch64 || arm_current_el(env) != 0 ||
+        arm_cpu_data_is_big_endian(env) ||
+        ((arm_sctlr(env, 0) & SCTLR_A) && (va & 1)) ||
+        !perp_stp_q_code(cpu, &word) ||
+        !perp_strh_post2_decode(word, &rt, &rn) ||
+        env->xregs[rn] != va || va > UINT64_MAX - 2) {
+        return false;
+    }
+    section = memory_region_find(address_space_memory.root, pa, sizeof(bytes));
+    mr = section.mr;
+    hole = mr && mr->ops == &unassigned_io_ops &&
+           !strcmp(memory_region_name(mr), "gpex_mmio_window") &&
+           !memory_region_is_ram(mr) && !mr->rom_device &&
+           int128_ge(section.size, int128_make64(sizeof(bytes)));
+    if (!hole) {
+        if (mr) memory_region_unref(mr);
+        return false;
+    }
+    /* WZR is zero. Store low 16 bits before updating Xn; the synchronized
+     * dirty CPU state is flushed by the existing HVF advance-PC path. */
+    stw_le_p(bytes, rt == 31 ? 0 : env->xregs[rt]);
+    result = address_space_write(&address_space_memory, pa,
+                                 MEMTXATTRS_UNSPECIFIED, bytes, sizeof(bytes));
+    memory_region_unref(mr);
+    if (result != MEMTX_OK) return false;
+    env->xregs[rn] = va + 2;
+    if (logged++ < 64) {
+        error_report("perpendicular-hvf-strh-post2-hole-v1 emulated=1 bytes=2");
+    }
+    return true;
+}
+#endif
