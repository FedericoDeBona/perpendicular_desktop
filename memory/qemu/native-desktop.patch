+/* SPDX-License-Identifier: MIT */
+#ifndef PERP_FLEXIBLE_MONITOR_EDID_H
+#define PERP_FLEXIBLE_MONITOR_EDID_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+/* The signed Wire1 Windows driver does not reliably enumerate CTA extension
+ * modes. Put a secondary 4K timing in the base block and advertise continuous
+ * CVT reduced-blanking timings. Keep the host's preferred boot timing, monitor
+ * identity, physical size, name and extension blocks. This is a virtual monitor;
+ * the guest agent separately enforces the configured resize/pixel limits. */
+static inline bool perp_flexible_monitor_edid(uint8_t *edid, size_t size)
+{
+    static const uint8_t header[8] = {0,255,255,255,255,255,255,0};
+    static const uint8_t timing_4k60[18] = {
+        0x08,0xe8,0x00,0x30,0xf2,0x70,0x5a,0x80,0xb0,0x58,0x8a,0x00,
+        0,0,0,0,0,0x1e
+    };
+    if (size < 128 || memcmp(edid, header, sizeof(header)) ||
+        edid[18] != 1 || edid[19] != 4) return false;
+    unsigned sum = 0;
+    for (unsigned i = 0; i < 128; i++) sum += edid[i];
+    if (sum & 255) return false;
+    uint8_t *extra = NULL, *range = NULL;
+    for (unsigned i = 72; i <= 108; i += 18) {
+        if (edid[i] || edid[i+1] || edid[i+2]) continue;
+        if (edid[i+3] == 0xf7) extra = edid+i;
+        if (edid[i+3] == 0xfd) range = edid+i;
+    }
+    if (!extra || !range) return false;
+    memcpy(extra, timing_4k60, sizeof(timing_4k60));
+    memcpy(extra+12, edid+66, 3); /* preferred timing's physical dimensions */
+    edid[24] |= 1; /* continuous frequency */
+    range[4] = (range[4] & 2) | 8; /* retain vertical maximum offset */
+    range[5] = 1;
+    if (!(range[4] & 2) && range[6] < 125) range[6] = 125;
+    range[7] = 1;
+    range[8] = 255; /* +255 offset = 510 kHz */
+    range[9] = 255; /* 2550 MHz */
+    range[10] = 4; range[11] = 0x11; /* CVT 1.1 */
+    range[12] = 0; range[13] = 0; /* no active-width limit */
+    range[14] = 0xf0; range[15] = 0x50; /* four aspects, prefer 16:10, RB */
+    range[16] = 0; range[17] = 60;
+    sum = 0;
+    for (unsigned i = 0; i < 127; i++) sum += edid[i];
+    edid[127] = (uint8_t)(0-sum);
+    return true;
+}
+#endif
