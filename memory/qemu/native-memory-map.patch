+/* Opt-in map for the bounded ARM64 HVF RAM runtime. Legacy virt places
+ * high PCI at >=256 GiB even when HVF exposes a smaller guest PA space. */
+static bool perp_hvf_small_pci_window(void)
+{
+#if defined(__APPLE__) && defined(__aarch64__)
+    const char *balloon = getenv("PERP_HVF_BALLOON_RECLAIM");
+    const char *memory = getenv("PERP_HVF_VIRTIO_MEM");
+    return balloon && !strcmp(balloon, "1") &&
+           memory && !strcmp(memory, "1");
+#else
+    return false;
+#endif
+}
