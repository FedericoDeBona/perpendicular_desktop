+/* An idle lease expires if the frontend stops renewing it. Interactive and
+ * legacy frontends retain the original 2 ms busy window by default. */
+static int64_t perp_idle_wfi_until;
+
+static bool perp_idle_wfi_enabled(Object *obj, Error **errp)
+{
+    int64_t until = qatomic_read(&perp_idle_wfi_until);
+    return until && qemu_clock_get_ns(QEMU_CLOCK_REALTIME) < until;
+}
+
+static void perp_idle_wfi_set(Object *obj, bool enabled, Error **errp)
+{
+    qatomic_set(&perp_idle_wfi_until, enabled ?
+        qemu_clock_get_ns(QEMU_CLOCK_REALTIME) + 10LL * NANOSECONDS_PER_SECOND : 0);
+}
+
+static char *perp_idle_wfi_stats(Object *obj, Error **errp)
+{
+    bool idle = perp_idle_wfi_enabled(obj, errp);
+    return g_strdup_printf("{\"version\":1,\"idle\":%s,\"busyNanoseconds\":%d}",
+                           idle ? "true" : "false", idle ? 250000 : 2000000);
+}
+
